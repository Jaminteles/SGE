# ==========================================================================
# SGE Backend - Variáveis de ambiente (RNF-003: NÃO versionar o .env real)
# Copie para .env e ajuste os valores. Segredos devem ser fortes e únicos.
# ==========================================================================

# Ambiente: development | test | production
NODE_ENV=development
PORT=3000

# Banco de dados (PostgreSQL) — banco criado por bd/*.sql.
# O parâmetro `schema=gestao` é OBRIGATÓRIO: define o search_path da conexão.
# O usuário sge_api (criado em bd/04) é sujeito à RLS — não use o owner na API.
# RNF-002: use SSL em produção.
DATABASE_URL="postgresql://sge_api:sge_api@localhost:5432/gestao_empresarial?schema=gestao"

# JWT - gere segredos fortes: `openssl rand -base64 48`
# NUNCA reutilize o mesmo segredo entre access e refresh.
JWT_ACCESS_SECRET="troque-por-um-segredo-forte-de-acesso"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_SECRET="troque-por-um-segredo-forte-de-refresh"
JWT_REFRESH_TTL="7d"

# Recuperação de senha (RF-009) - validade do token em minutos
PASSWORD_RESET_TTL_MINUTES=30

# CORS - origens permitidas separadas por vírgula
CORS_ORIGINS="http://localhost:5173"

# Rate limiting (janela em segundos / máximo de requisições)
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120

# Tempo máximo (ms) da transação que carrega o contexto RLS de cada requisição
REQUEST_TX_TIMEOUT_MS=20000

# Usuário administrador inicial (usado pelo seed) - RF-007
SEED_ADMIN_EMAIL="admin@sge.local"
SEED_ADMIN_PASSWORD="ChangeMe!2026"
SEED_ADMIN_NAME="Administrador do Sistema"
