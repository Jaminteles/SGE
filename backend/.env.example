# ==========================================================================
# SGE Backend - Variáveis de ambiente (RNF-003: NÃO versionar o .env real)
# Copie para .env e ajuste os valores. Segredos devem ser fortes e únicos.
# ==========================================================================

# Ambiente: development | test | production
NODE_ENV=development
PORT=3000

# Banco de dados (PostgreSQL) — banco criado por bd/*.sql.
# O parâmetro `schema=gestao` é OBRIGATÓRIO: define o search_path da conexão.
# O usuário sge_api (criado em bd/04) é sujeito à RLS — não use o owner na API.
# RNF-002: use SSL em produção.
DATABASE_URL="postgresql://sge_api:sge_api@localhost:5432/gestao_empresarial?schema=gestao"

# JWT - gere segredos fortes: `openssl rand -base64 48`
# NUNCA reutilize o mesmo segredo entre access e refresh.
JWT_ACCESS_SECRET="troque-por-um-segredo-forte-de-acesso"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_SECRET="troque-por-um-segredo-forte-de-refresh"
JWT_REFRESH_TTL="7d"

# Recuperação de senha (RF-009) - validade do token em minutos
PASSWORD_RESET_TTL_MINUTES=30

# CORS - origens permitidas separadas por vírgula
CORS_ORIGINS="http://localhost:5173"

# Rate limiting (janela em segundos / máximo de requisições)
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120

# Tempo máximo (ms) da transação que carrega o contexto RLS de cada requisição
REQUEST_TX_TIMEOUT_MS=20000

# Comprovantes de despesa (RF-019). Diretório local, fora do versionamento.
# São aceitos apenas PDF, JPEG e PNG, conferidos pela assinatura do arquivo.
STORAGE_LOCAL_ROOT="./storage"
UPLOAD_MAX_BYTES=10485760

# Usuário administrador inicial (usado pelo seed) - RF-007
SEED_ADMIN_EMAIL="admin@sge.local"
SEED_ADMIN_PASSWORD="ChangeMe!2026"
SEED_ADMIN_NAME="Administrador do Sistema"

# --- M09: Bancos, Pagamentos e Recebimentos (Sprint 10) ---

# Chave de cifra das credenciais de integração (RF-061 / RNF-003).
# 32 bytes em base64: `openssl rand -base64 32`.
# Trocar a chave torna ilegíveis as credenciais já gravadas — rotacione
# recadastrando os segredos, não substituindo a chave em produção.
INTEGRATION_ENCRYPTION_KEY="ZGV2LW9ubHkta2V5LWNoYW5nZS1tZS0zMmJ5dGVzISE="

# Chamadas a provedores financeiros.
INTEGRATION_HTTP_TIMEOUT_MS=10000
# Allowlist de hosts das integrações (anti-SSRF). Vazio = apenas o piso que
# recusa loopback, link-local e redes privadas. Em produção, liste os hosts.
INTEGRATION_ALLOWED_HOSTS=""
# Disjuntor: falhas seguidas até abrir e quanto tempo permanece aberto.
INTEGRATION_CIRCUIT_THRESHOLD=5
INTEGRATION_CIRCUIT_OPEN_MS=60000

# Fila de jobs (RF-069 / RF-070). A fila vive no PostgreSQL (`job_execucao`),
# reivindicada com FOR UPDATE SKIP LOCKED — vários processos podem consumi-la.
# Para separar API e worker (RNF-009): WORKER_ENABLED=false na API e true no
# processo de fila, com a mesma imagem.
WORKER_ENABLED=true
WORKER_POLL_INTERVAL_MS=5000
WORKER_BATCH_SIZE=5
# Backoff exponencial com jitter entre tentativas.
JOB_BACKOFF_BASE_MS=30000
JOB_BACKOFF_MAX_MS=3600000
