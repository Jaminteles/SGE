// SGE - Sistema de Gestão Empresarial e Financeira
// Sprint 1 (M01/M02), Sprint 2 (M16 Auditoria), Sprint 3 (M03 Funcionários e RH),
// Sprint 4 (M04 Clientes/Fornecedores + M05 Produtos e Serviços),
// Sprint 5 (M05 Estoque: locais, saldos, movimentação e inventário),
// Sprint 6 (M08 Contas a Pagar e Receber),
// Sprint 7 (M14 Fluxo de Caixa e Planejamento),
// Sprint 8 (M06 Compras: pedidos, aprovação, recebimento e conferência) e
// Sprint 9 (M07 Documentos Fiscais: importação de XML, processamento e vínculos) e
// Sprint 10 (M09 Bancos, Pagamentos e Recebimentos + importação de extrato)
// Sprint 11 (M10 Conciliação Bancária) e
// Sprint 12 (M13 OCR e Automação de Documentos)
//
// IMPORTANTE: este schema NÃO é dono do banco. O modelo físico vive em `bd/*.sql`
// (schema `gestao`, PostgreSQL 14+) e é a fonte da verdade. Aqui há apenas o
// mapeamento (@map/@@map) das tabelas usadas pela API. Não rode
// `prisma migrate`: mudanças estruturais são feitas nos scripts de `bd/`.
//
// Isolamento multiempresa é feito por RLS no banco (RN-001/RN-002): toda
// requisição roda em transação com `app.empresa_id`/`app.usuario_id` definidos
// (ver src/prisma/prisma.service.ts).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL") // deve conter ?schema=gestao
}

// ---------------------------------------------------------------------------
// Tipos enumerados do banco (bd/01_schema_core.sql §0.2)
// ---------------------------------------------------------------------------

enum PersonType {
  PF
  PJ
  ESTRANGEIRO

  @@map("enum_tipo_pessoa")
}

enum TaxRegime {
  SIMPLES_NACIONAL
  LUCRO_PRESUMIDO
  LUCRO_REAL
  MEI
  IMUNE_ISENTO

  @@map("enum_regime_tributario")
}

/// Natureza da categoria financeira: título a pagar ou a receber.
enum EntryType {
  PAGAR
  RECEBER

  @@map("enum_tipo_titulo")
}

/// Evento registrado na trilha de auditoria (RF-114).
/// CRIACAO/ALTERACAO/EXCLUSAO vêm do trigger de DML; os demais são eventos de
/// negócio gravados pela aplicação (bd/05, fn_registra_evento_auditoria).
enum AuditEvent {
  CRIACAO
  ALTERACAO
  EXCLUSAO
  APROVACAO
  REPROVACAO
  PAGAMENTO
  RECEBIMENTO
  CANCELAMENTO
  ESTORNO
  LOGIN
  LOGOUT
  ACESSO_NEGADO
  EXPORTACAO
  IMPORTACAO
  FECHAMENTO
  REABERTURA

  @@map("enum_tipo_evento_auditoria")
}

/// Situação do funcionário (`enum_status_funcionario`). Projetada pelo banco a
/// partir do histórico funcional (bd/06) — a API não a escreve diretamente.
enum EmployeeStatus {
  ATIVO
  AFASTADO
  FERIAS
  DESLIGADO

  @@map("enum_status_funcionario")
}

/// Evento do histórico funcional (RF-015/RF-020).
enum HrEventType {
  ADMISSAO
  PROMOCAO
  TRANSFERENCIA
  AFASTAMENTO
  FERIAS
  RETORNO
  DESLIGAMENTO
  ALTERACAO_SALARIAL

  @@map("enum_tipo_evento_rh")
}

/// Natureza da verba de folha (RF-017): provento, desconto ou encargo.
enum PayrollItemType {
  SALARIO
  BENEFICIO
  DESCONTO
  ADICIONAL
  ENCARGO

  @@map("enum_tipo_verba")
}

/// Situação da solicitação de reembolso (RF-018).
enum ReimbursementStatus {
  RASCUNHO
  SOLICITADO
  EM_ANALISE
  APROVADO
  REPROVADO
  PAGO
  CANCELADO

  @@map("enum_status_reembolso")
}

/// Natureza do item do catálogo (RF-028) — `enum_tipo_item`.
enum ItemType {
  PRODUTO
  SERVICO
  MATERIA_PRIMA
  ATIVO_IMOBILIZADO

  @@map("enum_tipo_item")
}

/// Meio de liquidação da forma de pagamento (RF-026) — `enum_metodo_pagamento`.
enum PaymentMethodType {
  PIX
  BOLETO
  TED
  DOC
  TRANSFERENCIA_INTERNA
  DEBITO_AUTOMATICO
  CARTAO_CREDITO
  CARTAO_DEBITO
  DINHEIRO
  CHEQUE
  COMPENSACAO
  OUTRO

  @@map("enum_metodo_pagamento")
}

/// Situação do título (M08). Usada em leitura pelo histórico do parceiro (RF-025).
enum EntryStatus {
  ABERTO
  PARCIALMENTE_LIQUIDADO
  LIQUIDADO
  CANCELADO
  RENEGOCIADO

  @@map("enum_status_titulo")
}

/// Situação do pedido de compra (M06). Leitura no histórico do parceiro (RF-025).
enum PurchaseOrderStatus {
  RASCUNHO
  AGUARDANDO_APROVACAO
  APROVADO
  REPROVADO
  PARCIALMENTE_RECEBIDO
  RECEBIDO
  CANCELADO

  @@map("enum_status_pedido_compra")
}

/// Direção do lançamento no razão do estoque (RF-032) — `enum_tipo_mov_estoque`.
///
/// `INVENTARIO` existe no tipo do banco mas não é lançável: bd/08 o recusa
/// porque não tem sinal definido. O ajuste apurado na contagem entra como
/// AJUSTE_POSITIVO/AJUSTE_NEGATIVO com `origin` = `INVENTARIO`.
enum StockMovementType {
  ENTRADA
  SAIDA
  TRANSFERENCIA_ENTRADA
  TRANSFERENCIA_SAIDA
  AJUSTE_POSITIVO
  AJUSTE_NEGATIVO
  INVENTARIO

  @@map("enum_tipo_mov_estoque")
}

/// Situação da parcela (RF-053/RF-057) — `enum_status_parcela`.
///
/// Projetada pelo banco a partir das baixas (bd/09): a API não a escreve.
enum InstallmentStatus {
  ABERTA
  PARCIALMENTE_LIQUIDADA
  LIQUIDADA
  CANCELADA
  RENEGOCIADA

  @@map("enum_status_parcela")
}

/// Situação da aprovação de um título (RF-056) — `enum_status_aprovacao`.
///
/// `NAO_REQUERIDA` é o título abaixo da alçada; `PENDENTE` bloqueia a baixa até
/// a decisão (bd/09). Aprovado e reprovado são terminais.
enum ApprovalStatus {
  NAO_REQUERIDA
  PENDENTE
  APROVADO
  REPROVADO
  CANCELADO

  @@map("enum_status_aprovacao")
}

/// Modelo do documento fiscal (RF-043) — `enum_modelo_doc_fiscal`.
enum FiscalDocumentModel {
  NFE
  NFCE
  NFSE
  CTE
  CTE_OS
  MDFE
  NFAVULSA
  RECIBO
  OUTRO

  @@map("enum_modelo_doc_fiscal")
}

/// Por onde o documento entrou (RF-043/RF-050) — `enum_origem_doc_fiscal`.
enum FiscalDocumentOrigin {
  UPLOAD_MANUAL
  COLETA_AUTOMATICA
  API
  EMAIL
  WEBHOOK

  @@map("enum_origem_doc_fiscal")
}

/// Situação do processamento (RF-049) — `enum_status_doc_fiscal`.
///
/// As transições válidas são aplicadas por trigger (bd/12): RECEBIDO abre,
/// PROCESSANDO/ERRO são o caminho do reprocessamento e CANCELADO/DENEGADO são
/// terminais. `DUPLICADO` é a segunda chegada do mesmo documento (RF-046).
enum FiscalDocumentStatus {
  RECEBIDO
  PROCESSANDO
  PROCESSADO
  ERRO
  DUPLICADO
  CANCELADO
  DENEGADO

  @@map("enum_status_doc_fiscal")
}

/// Periodicidade da recorrência (RF-053) — `enum_periodicidade`.
enum Periodicity {
  UNICA
  DIARIA
  SEMANAL
  QUINZENAL
  MENSAL
  BIMESTRAL
  TRIMESTRAL
  SEMESTRAL
  ANUAL

  @@map("enum_periodicidade")
}

// ---------------------------------------------------------------------------
// M02 — Usuários, Perfis e Permissões
// ---------------------------------------------------------------------------

/// gestao.usuario — identidade global; o acesso a cada empresa vem de Membership.
model User {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String    @map("nome") @db.VarChar(255)
  email             String    @unique(map: "uq_usuario_email") @db.VarChar(255)
  passwordHash      String    @map("senha_hash") // RNF-001: somente hash (argon2id)
  phone             String?   @map("telefone") @db.VarChar(20)
  isSuperAdmin      Boolean   @default(false) @map("super_admin")
  lastLoginAt       DateTime? @map("ultimo_login_em") @db.Timestamptz(6)
  /// Invalida access tokens emitidos antes da última troca de senha (RF-009).
  passwordChangedAt DateTime? @map("senha_alterada_em") @db.Timestamptz(6)
  isActive          Boolean   @default(true) @map("ativo")
  createdAt         DateTime  @default(now()) @map("criado_em") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  memberships          Membership[]
  sessions             Session[]
  passwordResets       PasswordResetToken[]
  approverOf           ApprovalApprover[]
  inventories          Inventory[]
  stockMovements       StockMovement[]
  financialEntries     FinancialEntry[]
  settlements          Settlement[]
  cashScenarios        CashFlowScenario[]
  cashAlerts           CashAlert[]
  purchaseOrders       PurchaseOrder[]       @relation("PedidoSolicitante")
  purchasesCreated     PurchaseOrder[]       @relation("PedidoCriador")
  purchasesDecided     PurchaseOrder[]       @relation("PedidoAprovador")
  receiptsChecked      GoodsReceipt[]        @relation("RecebimentoConferente")
  fiscalDocuments      FiscalDocument[]
  paymentTransactions  PaymentTransaction[]
  bankStatementImports BankStatementImport[]

  @@map("usuario")
}

/// gestao.sessao — refresh token (hash) para revogação server-side (RF-008).
model Session {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("usuario_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId String?   @map("empresa_id") @db.Uuid
  tokenHash String    @unique(map: "uq_sessao_token") @map("refresh_token_hash")
  ip        String?   @db.Inet
  userAgent String?   @map("user_agent")
  expiresAt DateTime  @map("expira_em") @db.Timestamptz(6)
  revokedAt DateTime? @map("revogada_em") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("criado_em") @db.Timestamptz(6)

  @@map("sessao")
}

/// gestao.token_recuperacao — token de reset de senha, hash e uso único (RF-009).
model PasswordResetToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("usuario_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique(map: "uq_token_recuperacao") @map("token_hash")
  purpose   String    @default("RESET_SENHA") @map("finalidade") @db.VarChar(40)
  expiresAt DateTime  @map("expira_em") @db.Timestamptz(6)
  usedAt    DateTime? @map("utilizado_em") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("criado_em") @db.Timestamptz(6)

  @@map("token_recuperacao")
}

/// gestao.perfil — perfil de acesso (RF-010). companyId nulo = perfil global do
/// sistema, visível a todas as empresas.
model Role {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   String?  @map("empresa_id") @db.Uuid
  company     Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String   @map("nome") @db.VarChar(120)
  description String?  @map("descricao")
  isSystem    Boolean  @default(false) @map("sistema")
  isActive    Boolean  @default(true) @map("ativo")
  createdAt   DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  permissions RolePermission[]
  memberships Membership[]
  approverOf  ApprovalApprover[]

  @@map("perfil")
}

/// gestao.permissao — catálogo global módulo + recurso + ação (RF-011).
/// O código usado na API é derivado: `recurso:acao`.
model Permission {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  module      String  @map("modulo") @db.VarChar(60)
  resource    String  @map("recurso") @db.VarChar(60)
  action      String  @map("acao") @db.VarChar(40)
  description String? @map("descricao")

  roles RolePermission[]

  @@unique([module, resource, action], map: "uq_permissao")
  @@map("permissao")
}

/// gestao.perfil_permissao — vínculo N:N entre perfil e permissão.
model RolePermission {
  roleId       String     @map("perfil_id") @db.Uuid
  permissionId String     @map("permissao_id") @db.Uuid
  grantedAt    DateTime   @default(now()) @map("concedida_em") @db.Timestamptz(6)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("perfil_permissao")
}

/// gestao.usuario_empresa — usuário ↔ empresa ↔ perfil (RF-004/RF-005).
/// branchId nulo = acesso a todas as filiais.
model Membership {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("usuario_id") @db.Uuid
  companyId String   @map("empresa_id") @db.Uuid
  roleId    String   @map("perfil_id") @db.Uuid
  branchId  String?  @map("filial_id") @db.Uuid
  isDefault Boolean  @default(false) @map("padrao")
  isActive  Boolean  @default(true) @map("ativo")
  createdAt DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  role    Role    @relation(fields: [roleId], references: [id])
  branch  Branch? @relation(fields: [branchId], references: [id])

  @@unique([userId, companyId, branchId, roleId], map: "uq_usuario_empresa")
  @@map("usuario_empresa")
}

// ---------------------------------------------------------------------------
// M01 — Empresas, Filiais e Configurações
// ---------------------------------------------------------------------------

/// gestao.empresa — tenant. Fronteira de isolamento (RF-005, RN-001).
model Company {
  id                    String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  legalName             String     @map("razao_social") @db.VarChar(255)
  tradeName             String?    @map("nome_fantasia") @db.VarChar(255)
  personType            PersonType @default(PJ) @map("tipo_pessoa")
  taxId                 String?    @map("cnpj") @db.VarChar(14)
  cpf                   String?    @db.VarChar(11)
  stateRegistration     String?    @map("inscricao_estadual") @db.VarChar(20)
  municipalRegistration String?    @map("inscricao_municipal") @db.VarChar(20)
  taxRegime             TaxRegime? @map("regime_tributario")
  mainCnae              String?    @map("cnae_principal") @db.VarChar(10)
  email                 String?    @db.VarChar(255)
  phone                 String?    @map("telefone") @db.VarChar(20)
  logoUrl               String?    @map("logo_url")
  timezone              String     @default("America/Sao_Paulo") @db.VarChar(50)
  currency              String     @default("BRL") @map("moeda") @db.Char(3)
  isActive              Boolean    @default(true) @map("ativo")
  createdAt             DateTime   @default(now()) @map("criado_em") @db.Timestamptz(6)
  updatedAt             DateTime   @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  branches           Branch[]
  memberships        Membership[]
  roles              Role[]
  categories         Category[]
  costCenters        CostCenter[]
  settings           CompanySetting[]
  approvalThresholds ApprovalThreshold[]
  cashScenarios      CashFlowScenario[]
  cashAlerts         CashAlert[]
  tenantAddresses    Address[]           @relation("EnderecoTenant")
  addresses          Address[]           @relation("EnderecoDaEmpresa")

  @@map("empresa")
}

/// gestao.filial — filial da empresa (RF-002).
model Branch {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId             String   @map("empresa_id") @db.Uuid
  company               Company  @relation(fields: [companyId], references: [id])
  code                  String   @map("codigo") @db.VarChar(20)
  name                  String   @map("nome") @db.VarChar(255)
  taxId                 String?  @map("cnpj") @db.VarChar(14)
  stateRegistration     String?  @map("inscricao_estadual") @db.VarChar(20)
  municipalRegistration String?  @map("inscricao_municipal") @db.VarChar(20)
  isHeadquarters        Boolean  @default(false) @map("matriz")
  isActive              Boolean  @default(true) @map("ativo")
  createdAt             DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)
  updatedAt             DateTime @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  addresses        Address[]
  memberships      Membership[]
  stockLocations   StockLocation[]
  financialEntries FinancialEntry[]
  purchaseOrders   PurchaseOrder[]
  receipts         GoodsReceipt[]
  fiscalDocuments  FiscalDocument[]
  bankAccounts     CompanyBankAccount[]

  @@unique([companyId, code], map: "uq_filial_codigo")
  @@map("filial")
}

/// gestao.endereco — endereço com dono controlado por CHECK (RF-003/RF-024).
/// Donos usados pela API: empresa, filial e parceiro — exatamente um por linha.
model Address {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId      String   @map("empresa_id") @db.Uuid
  tenant         Company  @relation("EnderecoTenant", fields: [companyId], references: [id], onDelete: Cascade)
  type           String   @default("PRINCIPAL") @map("tipo") @db.VarChar(30)
  street         String   @map("logradouro") @db.VarChar(255)
  number         String?  @map("numero") @db.VarChar(20)
  complement     String?  @map("complemento") @db.VarChar(100)
  district       String?  @map("bairro") @db.VarChar(120)
  city           String   @map("cidade") @db.VarChar(120)
  state          String   @map("uf") @db.Char(2)
  zipCode        String?  @map("cep") @db.VarChar(8)
  country        String   @default("Brasil") @map("pais") @db.VarChar(60)
  ibgeCode       String?  @map("codigo_ibge") @db.VarChar(7)
  isPrimary      Boolean  @default(false) @map("principal")
  ownerCompanyId String?  @map("empresa_ref_id") @db.Uuid
  ownerCompany   Company? @relation("EnderecoDaEmpresa", fields: [ownerCompanyId], references: [id], onDelete: Cascade)
  branchId       String?  @map("filial_id") @db.Uuid
  branch         Branch?  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  partnerId      String?  @map("parceiro_id") @db.Uuid
  partner        Partner? @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  @@map("endereco")
}

/// gestao.categoria_financeira — plano gerencial hierárquico (RF-006).
model Category {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId    String     @map("empresa_id") @db.Uuid
  company      Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parentId     String?    @map("categoria_pai_id") @db.Uuid
  parent       Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children     Category[] @relation("CategoryTree")
  code         String     @map("codigo") @db.VarChar(30)
  name         String     @map("nome") @db.VarChar(255)
  type         EntryType  @map("tipo")
  acceptsEntry Boolean    @default(true) @map("aceita_lancamento")
  isActive     Boolean    @default(true) @map("ativo")
  createdAt    DateTime   @default(now()) @map("criado_em") @db.Timestamptz(6)
  updatedAt    DateTime   @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  financialEntries FinancialEntry[]
  recurrences      Recurrence[]
  cashProjections  CashFlowProjection[]
  purchaseOrders   PurchaseOrder[]
  ocrSuggestions   OcrProcessing[]

  @@unique([companyId, code], map: "uq_categoria_financeira_codigo")
  @@map("categoria_financeira")
}

/// gestao.centro_custo — centro de custo hierárquico (RF-006).
model CostCenter {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId    String       @map("empresa_id") @db.Uuid
  company      Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branchId     String?      @map("filial_id") @db.Uuid
  parentId     String?      @map("centro_custo_pai_id") @db.Uuid
  parent       CostCenter?  @relation("CostCenterTree", fields: [parentId], references: [id])
  children     CostCenter[] @relation("CostCenterTree")
  code         String       @map("codigo") @db.VarChar(30)
  name         String       @map("nome") @db.VarChar(255)
  description  String?      @map("descricao")
  acceptsEntry Boolean      @default(true) @map("aceita_lancamento")
  isActive     Boolean      @default(true) @map("ativo")
  createdAt    DateTime     @default(now()) @map("criado_em") @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  financialEntries FinancialEntry[]
  recurrences      Recurrence[]
  cashProjections  CashFlowProjection[]
  purchaseOrders   PurchaseOrder[]
  purchaseItems    PurchaseOrderItem[]
  ocrSuggestions   OcrProcessing[]

  @@unique([companyId, code], map: "uq_centro_custo_codigo")
  @@map("centro_custo")
}

/// gestao.parametro_empresa — parâmetros chave/valor por grupo (RF-006).
model CompanySetting {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   String   @map("empresa_id") @db.Uuid
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  scope       String   @map("grupo") @db.VarChar(60)
  key         String   @map("chave") @db.VarChar(120)
  value       Json     @map("valor")
  description String?  @map("descricao")
  createdAt   DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  @@unique([companyId, scope, key], map: "uq_parametro_empresa")
  @@map("parametro_empresa")
}

/// gestao.alcada — faixa de valor que exige aprovação (RF-012, RN-003).
model ApprovalThreshold {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId    String   @map("empresa_id") @db.Uuid
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name         String   @map("nome") @db.VarChar(120)
  operation    String   @map("tipo_operacao") @db.VarChar(60)
  minAmount    Decimal  @default(0) @map("valor_minimo") @db.Decimal(18, 2)
  maxAmount    Decimal? @map("valor_maximo") @db.Decimal(18, 2)
  level        Int      @default(1) @map("nivel") @db.SmallInt
  minApprovers Int      @default(1) @map("aprovadores_min") @db.SmallInt
  isActive     Boolean  @default(true) @map("ativo")
  createdAt    DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  approvers ApprovalApprover[]

  @@unique([companyId, operation, level], map: "uq_alcada")
  @@map("alcada")
}

// ---------------------------------------------------------------------------
// M03 — Funcionários e Recursos Humanos (RF-013 a RF-021)
//
// As referências a empresa, filial, centro de custo, categoria e usuário ficam
// como colunas escalares: o vínculo com o tenant é garantido pelas FKs
// compostas (empresa_id, <coluna>) criadas em bd/06, e declarar a relação aqui
// só acrescentaria ida e volta ao Prisma sem uso nos serviços.
// ---------------------------------------------------------------------------

/// gestao.departamento — estrutura organizacional hierárquica (RF-014).
model Department {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId    String       @map("empresa_id") @db.Uuid
  parentId     String?      @map("departamento_pai_id") @db.Uuid
  parent       Department?  @relation("DepartmentTree", fields: [parentId], references: [id])
  children     Department[] @relation("DepartmentTree")
  costCenterId String?      @map("centro_custo_id") @db.Uuid
  code         String       @map("codigo") @db.VarChar(30)
  name         String       @map("nome") @db.VarChar(255)
  isActive     Boolean      @default(true) @map("ativo")
  createdAt    DateTime     @default(now()) @map("criado_em") @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  employees Employee[]
  events    EmployeeEvent[]

  @@unique([companyId, code], map: "uq_departamento_codigo")
  @@map("departamento")
}

/// gestao.cargo — cargo com faixa salarial e CBO (RF-014).
model Position {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   String   @map("empresa_id") @db.Uuid
  code        String   @map("codigo") @db.VarChar(30)
  name        String   @map("nome") @db.VarChar(255)
  cbo         String?  @db.VarChar(10)
  description String?  @map("descricao")
  minSalary   Decimal? @map("faixa_salarial_min") @db.Decimal(18, 2)
  maxSalary   Decimal? @map("faixa_salarial_max") @db.Decimal(18, 2)
  isActive    Boolean  @default(true) @map("ativo")
  createdAt   DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  employees Employee[]
  events    EmployeeEvent[]

  @@unique([companyId, code], map: "uq_cargo_codigo")
  @@map("cargo")
}

/// gestao.funcionario — cadastro funcional (RF-013, RF-014, RF-016).
///
/// `status`, `terminationDate` e o salário vigente são projetados pelo banco a
/// partir de `funcionario_evento` (bd/06): o histórico é a fonte da verdade.
model Employee {
  id                String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId         String         @map("empresa_id") @db.Uuid
  branchId          String?        @map("filial_id") @db.Uuid
  /// Usuário do sistema correspondente, quando o funcionário acessa a API.
  userId            String?        @map("usuario_id") @db.Uuid
  registration      String         @map("matricula") @db.VarChar(30)
  name              String         @map("nome") @db.VarChar(255)
  taxId             String         @map("cpf") @db.VarChar(11)
  rg                String?        @db.VarChar(20)
  pis               String?        @db.VarChar(15)
  birthDate         DateTime?      @map("data_nascimento") @db.Date
  corporateEmail    String?        @map("email_corporativo") @db.VarChar(255)
  phone             String?        @map("telefone") @db.VarChar(20)
  positionId        String?        @map("cargo_id") @db.Uuid
  position          Position?      @relation(fields: [positionId], references: [id])
  departmentId      String?        @map("departamento_id") @db.Uuid
  department        Department?    @relation(fields: [departmentId], references: [id])
  costCenterId      String?        @map("centro_custo_id") @db.Uuid
  managerId         String?        @map("gestor_id") @db.Uuid
  manager           Employee?      @relation("EmployeeHierarchy", fields: [managerId], references: [id])
  subordinates      Employee[]     @relation("EmployeeHierarchy")
  hireDate          DateTime       @map("data_admissao") @db.Date
  terminationDate   DateTime?      @map("data_desligamento") @db.Date
  terminationReason String?        @map("motivo_desligamento")
  contractType      String?        @map("tipo_contrato") @db.VarChar(40)
  status            EmployeeStatus @default(ATIVO)
  baseSalary        Decimal?       @map("salario_base") @db.Decimal(18, 2)
  createdAt         DateTime       @default(now()) @map("criado_em") @db.Timestamptz(6)
  updatedAt         DateTime       @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  bankAccounts     BankAccount[]
  events           EmployeeEvent[]
  payrollItems     EmployeePayrollItem[]
  reimbursements   Reimbursement[]
  financialEntries FinancialEntry[]
  purchaseOrders   PurchaseOrder[]

  @@unique([companyId, registration], map: "uq_funcionario_matricula")
  @@unique([companyId, taxId], map: "uq_funcionario_cpf")
  @@map("funcionario")
}

/// gestao.dado_bancario — conta para crédito de salário/reembolso (RF-013) e
/// para pagamento/recebimento de parceiro (RF-024).
///
/// O dono é exatamente um dos dois — funcionário **ou** parceiro —, garantido
/// pelo CHECK `ck_dado_bancario_proprietario` (bd/01).
model BankAccount {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId      String    @map("empresa_id") @db.Uuid
  employeeId     String?   @map("funcionario_id") @db.Uuid
  employee       Employee? @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  partnerId      String?   @map("parceiro_id") @db.Uuid
  partner        Partner?  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  bankCode       String?   @map("banco_codigo") @db.VarChar(5)
  bankName       String?   @map("banco_nome") @db.VarChar(120)
  agency         String?   @map("agencia") @db.VarChar(10)
  agencyDigit    String?   @map("agencia_digito") @db.VarChar(2)
  account        String?   @map("conta") @db.VarChar(20)
  accountDigit   String?   @map("conta_digito") @db.VarChar(2)
  accountType    String?   @map("tipo_conta") @db.VarChar(20)
  holderName     String?   @map("titular_nome") @db.VarChar(255)
  holderDocument String?   @map("titular_documento") @db.VarChar(14)
  pixKey         String?   @map("chave_pix") @db.VarChar(140)
  pixKeyType     String?   @map("tipo_chave_pix") @db.VarChar(20)
  isPrimary      Boolean   @default(false) @map("principal")
  isActive       Boolean   @default(true) @map("ativo")
  createdAt      DateTime  @default(now()) @map("criado_em") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  @@map("dado_bancario")
}

/// gestao.funcionario_evento — histórico funcional (RF-015, RF-020).
/// Append-only: bd/06 recusa UPDATE e DELETE — correção se faz com novo evento.
model EmployeeEvent {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId    String      @map("empresa_id") @db.Uuid
  employeeId   String      @map("funcionario_id") @db.Uuid
  employee     Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type         HrEventType @map("tipo")
  startDate    DateTime    @map("data_inicio") @db.Date
  endDate      DateTime?   @map("data_fim") @db.Date
  positionId   String?     @map("cargo_id") @db.Uuid
  position     Position?   @relation(fields: [positionId], references: [id])
  departmentId String?     @map("departamento_id") @db.Uuid
  department   Department? @relation(fields: [departmentId], references: [id])
  costCenterId String?     @map("centro_custo_id") @db.Uuid
  salary       Decimal?    @map("salario") @db.Decimal(18, 2)
  note         String?     @map("observacao")
  recordedBy   String?     @map("registrado_por") @db.Uuid
  createdAt    DateTime    @default(now()) @map("criado_em") @db.Timestamptz(6)

  @@index([employeeId, startDate(sort: Desc)], map: "ix_funcionario_evento_func")
  @@map("funcionario_evento")
}

/// gestao.verba — catálogo de salários, benefícios e descontos (RF-017/RF-021).
model PayrollItem {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId       String          @map("empresa_id") @db.Uuid
  code            String          @map("codigo") @db.VarChar(30)
  name            String          @map("nome") @db.VarChar(255)
  type            PayrollItemType @map("tipo")
  /// Conta contábil e categoria financeira ligam a folha à contabilidade (RF-021).
  ledgerAccountId String?         @map("conta_contabil_id") @db.Uuid
  categoryId      String?         @map("categoria_financeira_id") @db.Uuid
  affectsInss     Boolean         @default(false) @map("incide_inss")
  affectsIrrf     Boolean         @default(false) @map("incide_irrf")
  affectsFgts     Boolean         @default(false) @map("incide_fgts")
  isActive        Boolean         @default(true) @map("ativo")
  createdAt       DateTime        @default(now()) @map("criado_em") @db.Timestamptz(6)
  updatedAt       DateTime        @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  assignments EmployeePayrollItem[]

  @@unique([companyId, code], map: "uq_verba_codigo")
  @@map("verba")
}

/// gestao.funcionario_verba — verba atribuída a um funcionário com vigência.
/// bd/06 impede vigências sobrepostas da mesma verba (RF-017).
model EmployeePayrollItem {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId     String      @map("empresa_id") @db.Uuid
  employeeId    String      @map("funcionario_id") @db.Uuid
  employee      Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  payrollItemId String      @map("verba_id") @db.Uuid
  payrollItem   PayrollItem @relation(fields: [payrollItemId], references: [id])
  amount        Decimal?    @map("valor") @db.Decimal(18, 2)
  percentage    Decimal?    @map("percentual") @db.Decimal(9, 6)
  effectiveFrom DateTime    @map("vigencia_inicio") @db.Date
  effectiveTo   DateTime?   @map("vigencia_fim") @db.Date
  note          String?     @map("observacao")
  createdAt     DateTime    @default(now()) @map("criado_em") @db.Timestamptz(6)
  updatedAt     DateTime    @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  @@map("funcionario_verba")
}

/// gestao.reembolso — solicitação de reembolso de despesa (RF-018).
/// `totalAmount` é recalculado pelo banco a partir dos itens (bd/06).
model Reimbursement {
  id             String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId      String              @map("empresa_id") @db.Uuid
  branchId       String?             @map("filial_id") @db.Uuid
  employeeId     String              @map("funcionario_id") @db.Uuid
  employee       Employee            @relation(fields: [employeeId], references: [id])
  number         String              @map("numero") @db.VarChar(30)
  description    String              @map("descricao") @db.VarChar(255)
  requestDate    DateTime            @default(now()) @map("data_solicitacao") @db.Date
  totalAmount    Decimal             @default(0) @map("valor_total") @db.Decimal(18, 2)
  approvedAmount Decimal?            @map("valor_aprovado") @db.Decimal(18, 2)
  status         ReimbursementStatus @default(RASCUNHO)
  costCenterId   String?             @map("centro_custo_id") @db.Uuid
  /// Título a pagar gerado na liquidação (M08, sprint futura).
  payableId      String?             @map("titulo_id") @db.Uuid
  approvedBy     String?             @map("aprovado_por") @db.Uuid
  approvedAt     DateTime?           @map("aprovado_em") @db.Timestamptz(6)
  note           String?             @map("observacao")
  createdAt      DateTime            @default(now()) @map("criado_em") @db.Timestamptz(6)
  updatedAt      DateTime            @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  items ReimbursementItem[]

  @@unique([companyId, number], map: "uq_reembolso_numero")
  @@map("reembolso")
}

/// gestao.reembolso_item — despesa individual da solicitação (RF-018/RF-019).
model ReimbursementItem {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId       String          @map("empresa_id") @db.Uuid
  reimbursementId String          @map("reembolso_id") @db.Uuid
  reimbursement   Reimbursement   @relation(fields: [reimbursementId], references: [id], onDelete: Cascade)
  description     String          @map("descricao") @db.VarChar(255)
  expenseDate     DateTime        @map("data_despesa") @db.Date
  amount          Decimal         @map("valor") @db.Decimal(18, 2)
  categoryId      String?         @map("categoria_financeira_id") @db.Uuid
  costCenterId    String?         @map("centro_custo_id") @db.Uuid
  documentId      String?         @map("documento_id") @db.Uuid
  document        StoredDocument? @relation(fields: [documentId], references: [id])
  approved        Boolean?        @map("aprovado")
  note            String?         @map("observacao")
  createdAt       DateTime        @default(now()) @map("criado_em") @db.Timestamptz(6)

  @@index([reimbursementId], map: "ix_reembolso_item_reembolso")
  @@map("reembolso_item")
}

/// gestao.documento — arquivo armazenado (RF-019: comprovantes de despesa).
/// O binário fica no provedor de storage; aqui só os metadados e o hash.
model StoredDocument {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId       String   @map("empresa_id") @db.Uuid
  fileName        String   @map("nome_arquivo") @db.VarChar(255)
  mimeType        String?  @map("tipo_mime") @db.VarChar(120)
  sizeBytes       BigInt?  @map("tamanho_bytes")
  sha256          String?  @map("hash_sha256") @db.VarChar(64)
  storageProvider String   @default("S3") @map("storage_provider") @db.VarChar(40)
  storageKey      String   @map("storage_key")
  category        String?  @map("categoria") @db.VarChar(60)
  entity          String?  @map("entidade") @db.VarChar(60)
  entityId        String?  @map("entidade_id") @db.Uuid
  uploadedBy      String?  @map("enviado_por") @db.Uuid
  createdAt       DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)

  reimbursementItems ReimbursementItem[]
  ocrProcessings     OcrProcessing[]

  @@index([companyId, entity, entityId], map: "ix_documento_entidade")
  @@map("documento")
}

// ---------------------------------------------------------------------------
// M04 — Clientes e Fornecedores
//
// Modelagem do banco (bd/01): uma entidade `parceiro` com os papéis
// `eh_cliente`/`eh_fornecedor`, porque na prática a mesma pessoa jurídica
// exerce os dois. O que é específico de cada papel fica em `cliente` e
// `fornecedor` (1:1 com o parceiro).
// ---------------------------------------------------------------------------

/// gestao.parceiro — cliente e/ou fornecedor (RF-022, RF-023).
model Partner {
  id                    String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId             String     @map("empresa_id") @db.Uuid
  personType            PersonType @map("tipo_pessoa")
  code                  String?    @map("codigo") @db.VarChar(30)
  legalName             String     @map("razao_social") @db.VarChar(255)
  tradeName             String?    @map("nome_fantasia") @db.VarChar(255)
  cnpj                  String?    @db.VarChar(14)
  cpf                   String?    @db.VarChar(11)
  foreignDocument       String?    @map("documento_estrangeiro") @db.VarChar(30)
  stateRegistration     String?    @map("inscricao_estadual") @db.VarChar(20)
  municipalRegistration String?    @map("inscricao_municipal") @db.VarChar(20)
  icmsTaxpayer          Boolean    @default(false) @map("contribuinte_icms")
  taxRegime             TaxRegime? @map("regime_tributario")
  email                 String?    @db.VarChar(255)
  phone                 String?    @map("telefone") @db.VarChar(20)
  website               String?    @map("site") @db.VarChar(255)
  isCustomer            Boolean    @default(false) @map("eh_cliente")
  isSupplier            Boolean    @default(false) @map("eh_fornecedor")
  note                  String?    @map("observacao")
  isActive              Boolean    @default(true) @map("ativo")
  createdAt             DateTime   @default(now()) @map("criado_em") @db.Timestamptz(6)
  updatedAt             DateTime   @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  customer         Customer?
  supplier         Supplier?
  addresses        Address[]
  contacts         Contact[]
  bankAccounts     BankAccount[]
  products         ProductSupplier[]
  financialEntries FinancialEntry[]
  recurrences      Recurrence[]
  purchaseOrders   PurchaseOrder[]
  documentsIssued  FiscalDocument[]  @relation("NotaEmitente")
  documentsAddress FiscalDocument[]  @relation("NotaDestinatario")
  ocrSuggestions   OcrProcessing[]

  @@map("parceiro")
}

/// gestao.cliente — dados do papel cliente (RF-022, RF-026).
model Customer {
  partnerId       String         @id @map("parceiro_id") @db.Uuid
  partner         Partner        @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  companyId       String         @map("empresa_id") @db.Uuid
  creditLimit     Decimal        @default(0) @map("limite_credito") @db.Decimal(18, 2)
  paymentTermId   String?        @map("condicao_pagamento_id") @db.Uuid
  paymentTerm     PaymentTerm?   @relation(fields: [paymentTermId], references: [id])
  paymentMethodId String?        @map("forma_pagamento_id") @db.Uuid
  paymentMethod   PaymentMethod? @relation(fields: [paymentMethodId], references: [id])
  salesRepId      String?        @map("vendedor_id") @db.Uuid
  preferredDueDay Int?           @map("dia_vencimento_preferencial") @db.SmallInt
  isBlocked       Boolean        @default(false) @map("bloqueado")
  blockReason     String?        @map("motivo_bloqueio")
  createdAt       DateTime       @default(now()) @map("criado_em") @db.Timestamptz(6)
  updatedAt       DateTime       @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  @@map("cliente")
}

/// gestao.fornecedor — dados do papel fornecedor (RF-023, RF-026).
model Supplier {
  partnerId         String         @id @map("parceiro_id") @db.Uuid
  partner           Partner        @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  companyId         String         @map("empresa_id") @db.Uuid
  paymentTermId     String?        @map("condicao_pagamento_id") @db.Uuid
  paymentTerm       PaymentTerm?   @relation(fields: [paymentTermId], references: [id])
  paymentMethodId   String?        @map("forma_pagamento_id") @db.Uuid
  paymentMethod     PaymentMethod? @relation(fields: [paymentMethodId], references: [id])
  deliveryDays      Int?           @map("prazo_entrega_dias") @db.SmallInt
  defaultCategoryId String?        @map("categoria_financeira_padrao_id") @db.Uuid
  isApproved        Boolean        @default(false) @map("homologado")
  isBlocked         Boolean        @default(false) @map("bloqueado")
  blockReason       String?        @map("motivo_bloqueio")
  createdAt         DateTime       @default(now()) @map("criado_em") @db.Timestamptz(6)
  updatedAt         DateTime       @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  @@map("fornecedor")
}

/// gestao.contato — pessoa de contato do parceiro (RF-024).
model Contact {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String   @map("empresa_id") @db.Uuid
  partnerId String?  @map("parceiro_id") @db.Uuid
  partner   Partner? @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  branchId  String?  @map("filial_id") @db.Uuid
  name      String   @map("nome") @db.VarChar(255)
  role      String?  @map("cargo") @db.VarChar(120)
  email     String?  @db.VarChar(255)
  phone     String?  @map("telefone") @db.VarChar(20)
  mobile    String?  @map("celular") @db.VarChar(20)
  note      String?  @map("observacao")
  isPrimary Boolean  @default(false) @map("principal")
  createdAt DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  @@map("contato")
}

/// gestao.forma_pagamento — meio de liquidação (RF-026).
model PaymentMethod {
  id        String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String            @map("empresa_id") @db.Uuid
  code      String            @map("codigo") @db.VarChar(30)
  name      String            @map("nome") @db.VarChar(120)
  method    PaymentMethodType @map("metodo")
  isActive  Boolean           @default(true) @map("ativo")
  createdAt DateTime          @default(now()) @map("criado_em") @db.Timestamptz(6)
  updatedAt DateTime          @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  customers        Customer[]
  suppliers        Supplier[]
  financialEntries FinancialEntry[]
  settlements      Settlement[]
  purchaseOrders   PurchaseOrder[]

  @@unique([companyId, code], map: "uq_forma_pagamento")
  @@map("forma_pagamento")
}

/// gestao.condicao_pagamento — parcelamento e desconto (RF-026).
model PaymentTerm {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId       String   @map("empresa_id") @db.Uuid
  code            String   @map("codigo") @db.VarChar(30)
  name            String   @map("nome") @db.VarChar(120)
  installments    Int      @default(1) @map("quantidade_parcelas") @db.SmallInt
  intervalDays    Int      @default(30) @map("intervalo_dias") @db.SmallInt
  firstDueDays    Int      @default(30) @map("dias_primeira_parcela") @db.SmallInt
  discountPercent Decimal  @default(0) @map("percentual_desconto") @db.Decimal(9, 6)
  isActive        Boolean  @default(true) @map("ativo")
  createdAt       DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  customers        Customer[]
  suppliers        Supplier[]
  financialEntries FinancialEntry[]
  purchaseOrders   PurchaseOrder[]

  @@unique([companyId, code], map: "uq_condicao_pagamento")
  @@map("condicao_pagamento")
}

// ---------------------------------------------------------------------------
// M05 — Produtos e Serviços (cadastro; estoque fica na Sprint 5)
// ---------------------------------------------------------------------------

/// gestao.unidade_medida — unidade comercial do item (RF-029).
model UnitOfMeasure {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   String  @map("empresa_id") @db.Uuid
  symbol      String  @map("sigla") @db.VarChar(6)
  description String  @map("descricao") @db.VarChar(60)
  isActive    Boolean @default(true) @map("ativo")

  products Product[]

  @@unique([companyId, symbol], map: "uq_unidade_medida")
  @@map("unidade_medida")
}

/// gestao.categoria_produto — categoria hierárquica do catálogo (RF-029).
model ProductCategory {
  id        String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String            @map("empresa_id") @db.Uuid
  parentId  String?           @map("categoria_pai_id") @db.Uuid
  parent    ProductCategory?  @relation("ProductCategoryTree", fields: [parentId], references: [id])
  children  ProductCategory[] @relation("ProductCategoryTree")
  code      String            @map("codigo") @db.VarChar(30)
  name      String            @map("nome") @db.VarChar(255)
  isActive  Boolean           @default(true) @map("ativo")
  createdAt DateTime          @default(now()) @map("criado_em") @db.Timestamptz(6)

  products Product[]

  @@unique([companyId, code], map: "uq_categoria_produto")
  @@map("categoria_produto")
}

/// gestao.produto — produto ou serviço (RF-028, RF-029, RF-030).
///
/// `custo_medio`, `custo_ultima_compra` e `data_ultima_compra` são projetados
/// pela movimentação de estoque e pelas compras (Sprints 5 e 8): a API desta
/// sprint não os escreve.
model Product {
  id                  String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId           String           @map("empresa_id") @db.Uuid
  type                ItemType         @default(PRODUTO) @map("tipo")
  code                String           @map("codigo") @db.VarChar(60)
  barcode             String?          @map("codigo_barras") @db.VarChar(30)
  description         String           @map("descricao") @db.VarChar(255)
  extraDescription    String?          @map("descricao_complementar")
  categoryId          String?          @map("categoria_produto_id") @db.Uuid
  category            ProductCategory? @relation(fields: [categoryId], references: [id])
  unitId              String?          @map("unidade_medida_id") @db.Uuid
  unit                UnitOfMeasure?   @relation(fields: [unitId], references: [id])
  ncm                 String?          @db.VarChar(8)
  cest                String?          @db.VarChar(7)
  defaultInboundCfop  String?          @map("cfop_padrao_entrada") @db.VarChar(4)
  defaultOutboundCfop String?          @map("cfop_padrao_saida") @db.VarChar(4)
  goodsOrigin         Int?             @map("origem_mercadoria") @db.SmallInt
  serviceCodeLc116    String?          @map("codigo_servico_lc116") @db.VarChar(10)
  averageCost         Decimal          @default(0) @map("custo_medio") @db.Decimal(18, 6)
  lastPurchaseCost    Decimal?         @map("custo_ultima_compra") @db.Decimal(18, 6)
  lastPurchaseDate    DateTime?        @map("data_ultima_compra") @db.Date
  salePrice           Decimal?         @map("preco_venda") @db.Decimal(18, 6)
  defaultMargin       Decimal?         @map("margem_padrao") @db.Decimal(9, 6)
  tracksStock         Boolean          @default(true) @map("controla_estoque")
  minStock            Decimal          @default(0) @map("estoque_minimo") @db.Decimal(18, 6)
  maxStock            Decimal?         @map("estoque_maximo") @db.Decimal(18, 6)
  netWeight           Decimal?         @map("peso_liquido") @db.Decimal(14, 4)
  grossWeight         Decimal?         @map("peso_bruto") @db.Decimal(14, 4)
  isActive            Boolean          @default(true) @map("ativo")
  createdAt           DateTime         @default(now()) @map("criado_em") @db.Timestamptz(6)
  updatedAt           DateTime         @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  suppliers      ProductSupplier[]
  balances       StockBalance[]
  movements      StockMovement[]
  inventoryItems InventoryItem[]
  purchaseItems  PurchaseOrderItem[]
  receiptItems   GoodsReceiptItem[]
  fiscalItems    FiscalDocumentItem[]

  @@unique([companyId, code], map: "uq_produto_codigo")
  @@map("produto")
}

/// gestao.produto_fornecedor — fornecedores homologados do item (RF-027).
model ProductSupplier {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId      String   @map("empresa_id") @db.Uuid
  productId      String   @map("produto_id") @db.Uuid
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  partnerId      String   @map("parceiro_id") @db.Uuid
  partner        Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  supplierCode   String?  @map("codigo_no_fornecedor") @db.VarChar(60)
  referencePrice Decimal? @map("preco_referencia") @db.Decimal(18, 6)
  deliveryDays   Int?     @map("prazo_entrega_dias") @db.SmallInt
  isPreferred    Boolean  @default(false) @map("preferencial")
  createdAt      DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)

  @@unique([productId, partnerId], map: "uq_produto_fornecedor")
  @@map("produto_fornecedor")
}

// ---------------------------------------------------------------------------
// M05 — Estoque (RF-031 a RF-035)
//
// `movimento_estoque` é o razão: append-only, e a única porta de entrada do
// estoque. `estoque_saldo` é a projeção mantida por trigger (bd/08) e não é
// gravável pela role da aplicação — por isso não há nenhum `create`/`update`
// de StockBalance nos services.
// ---------------------------------------------------------------------------

/// gestao.local_estoque — depósito/almoxarifado de uma filial (RF-031).
model StockLocation {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String   @map("empresa_id") @db.Uuid
  branchId  String   @map("filial_id") @db.Uuid
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  code      String   @map("codigo") @db.VarChar(30)
  name      String   @map("nome") @db.VarChar(255)
  isDefault Boolean  @default(false) @map("padrao")
  isActive  Boolean  @default(true) @map("ativo")
  createdAt DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)

  balances      StockBalance[]
  movements     StockMovement[]     @relation("MovimentoLocal")
  counterpartOf StockMovement[]     @relation("MovimentoContraparte")
  inventories   Inventory[]
  purchaseItems PurchaseOrderItem[]
  receipts      GoodsReceipt[]

  @@unique([companyId, code], map: "uq_local_estoque")
  @@map("local_estoque")
}

/// gestao.estoque_saldo — saldo e custo médio por produto/local (RF-031/RF-034).
///
/// Somente leitura pela API: o banco revoga INSERT/UPDATE/DELETE da role da
/// aplicação (bd/08) e a projeção é escrita apenas pelo trigger do razão.
model StockBalance {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   String        @map("empresa_id") @db.Uuid
  productId   String        @map("produto_id") @db.Uuid
  product     Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  locationId  String        @map("local_estoque_id") @db.Uuid
  location    StockLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  quantity    Decimal       @default(0) @map("quantidade") @db.Decimal(18, 6)
  reserved    Decimal       @default(0) @map("quantidade_reservada") @db.Decimal(18, 6)
  averageCost Decimal       @default(0) @map("custo_medio") @db.Decimal(18, 6)
  totalValue  Decimal       @default(0) @map("valor_total") @db.Decimal(18, 2)
  updatedAt   DateTime      @default(now()) @map("atualizado_em") @db.Timestamptz(6)

  @@unique([productId, locationId], map: "uq_estoque_saldo")
  @@map("estoque_saldo")
}

/// gestao.movimento_estoque — razão do estoque, append-only (RF-032).
///
/// `previousBalance`, `newBalance` e `totalValue` são calculados pelo trigger
/// `trg_prepara_movimento_estoque` (bd/08): a API não os envia.
model StockMovement {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId        String            @map("empresa_id") @db.Uuid
  productId        String            @map("produto_id") @db.Uuid
  product          Product           @relation(fields: [productId], references: [id])
  locationId       String            @map("local_estoque_id") @db.Uuid
  location         StockLocation     @relation("MovimentoLocal", fields: [locationId], references: [id])
  /// Contraparte da transferência: o outro local envolvido na operação.
  counterpartId    String?           @map("local_destino_id") @db.Uuid
  counterpart      StockLocation?    @relation("MovimentoContraparte", fields: [counterpartId], references: [id])
  type             StockMovementType @map("tipo")
  movementDate     DateTime          @default(now()) @map("data_movimento") @db.Timestamptz(6)
  quantity         Decimal           @map("quantidade") @db.Decimal(18, 6)
  unitCost         Decimal           @default(0) @map("custo_unitario") @db.Decimal(18, 6)
  totalValue       Decimal           @default(0) @map("valor_total") @db.Decimal(18, 2)
  previousBalance  Decimal?          @map("saldo_anterior") @db.Decimal(18, 6)
  newBalance       Decimal?          @map("saldo_posterior") @db.Decimal(18, 6)
  origin           String?           @map("origem_tipo") @db.VarChar(40)
  originId         String?           @map("origem_id") @db.Uuid
  /// Nota que amparou a entrada (RF-047). Com `origin` = DOCUMENTO_FISCAL,
  /// `originId` é o **item** da nota — a granularidade que o índice único de
  /// bd/12 usa para permitir uma entrada por linha e recusar a repetição.
  fiscalDocumentId String?           @map("documento_fiscal_id") @db.Uuid
  fiscalDocument   FiscalDocument?   @relation(fields: [fiscalDocumentId], references: [id])
  batch            String?           @map("lote") @db.VarChar(60)
  note             String?           @map("observacao")
  userId           String?           @map("usuario_id") @db.Uuid
  user             User?             @relation(fields: [userId], references: [id])
  createdAt        DateTime          @default(now()) @map("criado_em") @db.Timestamptz(6)

  @@index([productId, movementDate(sort: Desc)], map: "ix_movimento_estoque_produto")
  @@map("movimento_estoque")
}

/// gestao.inventario — contagem física de um local (RF-033).
model Inventory {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId     String        @map("empresa_id") @db.Uuid
  locationId    String        @map("local_estoque_id") @db.Uuid
  location      StockLocation @relation(fields: [locationId], references: [id])
  number        String        @map("numero") @db.VarChar(30)
  description   String?       @map("descricao") @db.VarChar(255)
  startedAt     DateTime      @default(now()) @map("data_inicio") @db.Timestamptz(6)
  finishedAt    DateTime?     @map("data_conclusao") @db.Timestamptz(6)
  /// ABERTO | EM_CONTAGEM | CONCLUIDO | CANCELADO — CHECK em bd/08.
  status        String        @default("ABERTO") @db.VarChar(20)
  responsibleId String?       @map("responsavel_id") @db.Uuid
  responsible   User?         @relation(fields: [responsibleId], references: [id])
  createdAt     DateTime      @default(now()) @map("criado_em") @db.Timestamptz(6)

  items InventoryItem[]

  @@unique([companyId, number], map: "uq_inventario_numero")
  @@map("inventario")
}

/// gestao.inventario_item — item contado. `difference` é coluna gerada no banco.
model InventoryItem {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId       String    @map("empresa_id") @db.Uuid
  inventoryId     String    @map("inventario_id") @db.Uuid
  inventory       Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  productId       String    @map("produto_id") @db.Uuid
  product         Product   @relation(fields: [productId], references: [id])
  systemQuantity  Decimal   @default(0) @map("quantidade_sistema") @db.Decimal(18, 6)
  countedQuantity Decimal?  @map("quantidade_contada") @db.Decimal(18, 6)
  /// GENERATED ALWAYS AS (coalesce(contada,0) - sistema) STORED — leitura apenas.
  /// O `@default` existe só para o Prisma não exigir a coluna no INSERT: quem a
  /// calcula é o banco, e enviá-la seria erro de escrita em coluna gerada.
  difference      Decimal   @default(0) @map("diferenca") @db.Decimal(18, 6)
  unitCost        Decimal?  @map("custo_unitario") @db.Decimal(18, 6)
  isAdjusted      Boolean   @default(false) @map("ajustado")
  note            String?   @map("observacao")

  @@unique([inventoryId, productId], map: "uq_inventario_item")
  @@map("inventario_item")
}

// ---------------------------------------------------------------------------
// M08 — Contas a Pagar e Receber (RF-051 a RF-058)
//
// Uma entidade só (`titulo`) discriminada por `type`: a pagar e a receber
// compartilham parcelas, baixas, encargos e aprovação — separá-las duplicaria
// toda a mecânica para trocar o sinal do fluxo.
//
// Saldo e situação **não são escritos pela API**. A única porta de entrada da
// liquidação é um INSERT em `titulo_baixa`; o banco projeta a parcela a partir
// das baixas vivas e o título a partir das parcelas (bd/09). Como no estoque, a
// garantia é de privilégio: a role da aplicação não tem UPDATE nem DELETE sobre
// as baixas — estorno é lançamento contrário, não edição.
// ---------------------------------------------------------------------------

/// gestao.recorrencia — contrato que gera títulos periodicamente (RF-053).
model Recurrence {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId      String      @map("empresa_id") @db.Uuid
  description    String      @map("descricao") @db.VarChar(255)
  type           EntryType   @map("tipo")
  periodicity    Periodicity @map("periodicidade")
  /// Dia desejado do vencimento; o banco reduz para o último dia do mês curto.
  dueDay         Int?        @map("dia_vencimento") @db.SmallInt
  defaultAmount  Decimal?    @map("valor_padrao") @db.Decimal(18, 2)
  partnerId      String?     @map("parceiro_id") @db.Uuid
  partner        Partner?    @relation(fields: [partnerId], references: [id])
  categoryId     String?     @map("categoria_financeira_id") @db.Uuid
  category       Category?   @relation(fields: [categoryId], references: [id])
  costCenterId   String?     @map("centro_custo_id") @db.Uuid
  costCenter     CostCenter? @relation(fields: [costCenterId], references: [id])
  startDate      DateTime    @map("data_inicio") @db.Date
  endDate        DateTime?   @map("data_fim") @db.Date
  maxOccurrences Int?        @map("ocorrencias_max") @db.SmallInt
  generatedCount Int         @default(0) @map("ocorrencias_geradas") @db.SmallInt
  nextRunDate    DateTime?   @map("proxima_geracao") @db.Date
  isActive       Boolean     @default(true) @map("ativo")
  createdAt      DateTime    @default(now()) @map("criado_em") @db.Timestamptz(6)
  updatedAt      DateTime    @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  entries FinancialEntry[]

  @@map("recorrencia")
}

/// gestao.titulo — título a pagar ou a receber (RF-051 a RF-058).
///
/// `netAmount` é derivado (`grossAmount - discountAmount`), e `settledAmount`,
/// `balance` e `status` são projeção das parcelas: todos escritos por trigger
/// (bd/09). A API os envia apenas na leitura.
model FinancialEntry {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId         String          @map("empresa_id") @db.Uuid
  branchId          String?         @map("filial_id") @db.Uuid
  branch            Branch?         @relation(fields: [branchId], references: [id])
  type              EntryType       @map("tipo")
  number            String          @map("numero") @db.VarChar(30)
  documentReference String?         @map("documento_referencia") @db.VarChar(60)
  partnerId         String?         @map("parceiro_id") @db.Uuid
  partner           Partner?        @relation(fields: [partnerId], references: [id])
  /// Contraparte funcionário: reembolso aprovado vira título a pagar (RF-018).
  employeeId        String?         @map("funcionario_id") @db.Uuid
  employee          Employee?       @relation(fields: [employeeId], references: [id])
  description       String          @map("descricao") @db.VarChar(255)
  issueDate         DateTime        @default(now()) @map("data_emissao") @db.Date
  competenceDate    DateTime        @default(now()) @map("data_competencia") @db.Date
  grossAmount       Decimal         @map("valor_bruto") @db.Decimal(18, 2)
  discountAmount    Decimal         @default(0) @map("valor_desconto") @db.Decimal(18, 2)
  netAmount         Decimal         @map("valor_liquido") @db.Decimal(18, 2)
  /// Caixa movimentado nas baixas vivas — inclui juros e multa recebidos/pagos.
  settledAmount     Decimal         @default(0) @map("valor_liquidado") @db.Decimal(18, 2)
  /// Principal ainda em aberto: a soma do saldo das parcelas não canceladas.
  balance           Decimal         @default(0) @map("saldo") @db.Decimal(18, 2)
  categoryId        String?         @map("categoria_financeira_id") @db.Uuid
  category          Category?       @relation(fields: [categoryId], references: [id])
  costCenterId      String?         @map("centro_custo_id") @db.Uuid
  costCenter        CostCenter?     @relation(fields: [costCenterId], references: [id])
  /// Conta contábil (M11): classificada aqui, usada na partida dobrada.
  ledgerAccountId   String?         @map("conta_contabil_id") @db.Uuid
  paymentMethodId   String?         @map("forma_pagamento_id") @db.Uuid
  paymentMethod     PaymentMethod?  @relation(fields: [paymentMethodId], references: [id])
  paymentTermId     String?         @map("condicao_pagamento_id") @db.Uuid
  paymentTerm       PaymentTerm?    @relation(fields: [paymentTermId], references: [id])
  /// MANUAL | RECORRENCIA | REEMBOLSO | RECEBIMENTO | DOCUMENTO_FISCAL.
  origin            String?         @map("origem_tipo") @db.VarChar(40)
  originId          String?         @map("origem_id") @db.Uuid
  /// Pedido que deu causa ao título (RF-041). O `originId` guarda o recebimento.
  purchaseOrderId   String?         @map("pedido_compra_id") @db.Uuid
  purchaseOrder     PurchaseOrder?  @relation(fields: [purchaseOrderId], references: [id])
  recurrenceId      String?         @map("recorrencia_id") @db.Uuid
  recurrence        Recurrence?     @relation(fields: [recurrenceId], references: [id])
  /// Nota que deu causa ao título (RF-047). Quando o título nasce do
  /// recebimento, é o `fiscalDocumentId` dele — não este.
  fiscalDocumentId  String?         @map("documento_fiscal_id") @db.Uuid
  fiscalDocument    FiscalDocument? @relation(fields: [fiscalDocumentId], references: [id])
  status            EntryStatus     @default(ABERTO) @map("status")
  approvalStatus    ApprovalStatus  @default(NAO_REQUERIDA) @map("status_aprovacao")
  canceledAt        DateTime?       @map("cancelado_em") @db.Timestamptz(6)
  cancelReason      String?         @map("motivo_cancelamento")
  note              String?         @map("observacao")
  createdById       String?         @map("criado_por") @db.Uuid
  createdBy         User?           @relation(fields: [createdById], references: [id])
  createdAt         DateTime        @default(now()) @map("criado_em") @db.Timestamptz(6)
  updatedAt         DateTime        @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  installments FinancialInstallment[]

  @@unique([companyId, type, number], map: "uq_titulo_numero")
  @@index([companyId, competenceDate], map: "ix_titulo_competencia")
  @@map("titulo")
}

/// gestao.titulo_parcela — vencimento e valor de cada parcela (RF-053/RF-055).
///
/// `balance` é o **principal em aberto** e `settledAmount`, o **caixa
/// movimentado**: pagar juros não abate principal. Os dois, mais os encargos
/// acumulados e a situação, são projeção das baixas (bd/09).
model FinancialInstallment {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId         String            @map("empresa_id") @db.Uuid
  entryId           String            @map("titulo_id") @db.Uuid
  entry             FinancialEntry    @relation(fields: [entryId], references: [id], onDelete: Cascade)
  number            Int               @map("numero_parcela") @db.SmallInt
  totalInstallments Int               @default(1) @map("total_parcelas") @db.SmallInt
  dueDate           DateTime          @map("data_vencimento") @db.Date
  /// Vencimento combinado na emissão — imutável, mesmo se a parcela for prorrogada.
  originalDueDate   DateTime?         @map("data_vencimento_original") @db.Date
  amount            Decimal           @map("valor") @db.Decimal(18, 2)
  interestAmount    Decimal           @default(0) @map("valor_juros") @db.Decimal(18, 2)
  penaltyAmount     Decimal           @default(0) @map("valor_multa") @db.Decimal(18, 2)
  discountAmount    Decimal           @default(0) @map("valor_desconto") @db.Decimal(18, 2)
  settledAmount     Decimal           @default(0) @map("valor_liquidado") @db.Decimal(18, 2)
  balance           Decimal           @default(0) @map("saldo") @db.Decimal(18, 2)
  dailyInterestRate Decimal           @default(0) @map("percentual_juros_dia") @db.Decimal(9, 6)
  penaltyRate       Decimal           @default(0) @map("percentual_multa") @db.Decimal(9, 6)
  settledAt         DateTime?         @map("data_liquidacao") @db.Date
  status            InstallmentStatus @default(ABERTA) @map("status")
  barcode           String?           @map("codigo_barras") @db.VarChar(60)
  digitableLine     String?           @map("linha_digitavel") @db.VarChar(60)
  bankIdentifier    String?           @map("nosso_numero") @db.VarChar(30)
  note              String?           @map("observacao")
  createdAt         DateTime          @default(now()) @map("criado_em") @db.Timestamptz(6)
  updatedAt         DateTime          @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  settlements         Settlement[]
  paymentTransactions PaymentTransaction[]
  reconciliations     Reconciliation[]

  @@unique([entryId, number], map: "uq_titulo_parcela")
  @@map("titulo_parcela")
}

/// gestao.titulo_baixa — pagamento ou recebimento, total ou parcial (RF-057).
///
/// Append-only: a role da aplicação não tem UPDATE nem DELETE (bd/09). Estornar
/// é inserir o lançamento espelho com `reversalOfId`; o banco marca a original.
model Settlement {
  id              String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId       String               @map("empresa_id") @db.Uuid
  installmentId   String               @map("titulo_parcela_id") @db.Uuid
  installment     FinancialInstallment @relation(fields: [installmentId], references: [id])
  settlementDate  DateTime             @default(now()) @map("data_baixa") @db.Date
  /// Principal quitado — é ele, e só ele, que abate o saldo da parcela.
  principalAmount Decimal              @map("valor_principal") @db.Decimal(18, 2)
  interestAmount  Decimal              @default(0) @map("valor_juros") @db.Decimal(18, 2)
  penaltyAmount   Decimal              @default(0) @map("valor_multa") @db.Decimal(18, 2)
  discountAmount  Decimal              @default(0) @map("valor_desconto") @db.Decimal(18, 2)
  /// Caixa movimentado — calculado pelo banco a partir das quatro parcelas acima.
  totalAmount     Decimal              @default(0) @map("valor_total") @db.Decimal(18, 2)
  paymentMethodId String?              @map("forma_pagamento_id") @db.Uuid
  paymentMethod   PaymentMethod?       @relation(fields: [paymentMethodId], references: [id])
  method          PaymentMethodType?   @map("metodo")
  /// Conta de onde o dinheiro saiu ou entrou (RF-059). Escalar de propósito: a
  /// baixa é append-only e ninguém navega dela para a conta.
  bankAccountId   String?              @map("conta_bancaria_id") @db.Uuid
  /// Ordem de pagamento que produziu esta baixa (RF-062). Única por transação
  /// (bd/13 §6): é o índice que impede o pagamento duplicado — RN-004.
  transactionId   String?              @map("transacao_pagamento_id") @db.Uuid
  transaction     PaymentTransaction?  @relation(fields: [transactionId], references: [id])
  isReversed      Boolean              @default(false) @map("estornada")
  /// Única por definição: uma baixa é estornada uma vez só, garantido pelo
  /// índice parcial `ux_baixa_estorno_unico` (bd/09).
  reversalOfId    String?              @unique(map: "ux_baixa_estorno_unico") @map("estorno_de_id") @db.Uuid
  reversalOf      Settlement?          @relation("SettlementReversal", fields: [reversalOfId], references: [id])
  reversal        Settlement?          @relation("SettlementReversal")
  reversedAt      DateTime?            @map("estornada_em") @db.Timestamptz(6)
  reversalReason  String?              @map("motivo_estorno")
  note            String?              @map("observacao")
  createdById     String?              @map("criado_por") @db.Uuid
  createdBy       User?                @relation(fields: [createdById], references: [id])
  createdAt       DateTime             @default(now()) @map("criado_em") @db.Timestamptz(6)

  @@map("titulo_baixa")
}

// ---------------------------------------------------------------------------
// M14 — Fluxo de Caixa e Planejamento (RF-101 a RF-105)
//
// O fluxo consolidado **não** tem modelo aqui: ele é a visão `vw_fluxo_caixa`
// (bd/10), lida por query bruta. Só o que um humano decide é gravado — o
// cenário, as projeções que ele digita e a configuração do alerta.
// ---------------------------------------------------------------------------

/// Situação de um movimento no fluxo de caixa (RF-103) — `enum_realizacao`.
///
/// REALIZADO é baixa viva; VENCIDO e PREVISTO são parcela em aberto antes e
/// depois de hoje. Só PREVISTO pode ser digitado (bd/10).
enum Realization {
  PREVISTO
  REALIZADO
  VENCIDO

  @@map("enum_realizacao")
}

/// gestao.cenario_fluxo_caixa — janela de planejamento com premissas (RF-104).
///
/// `assumptions` aceita apenas `entradas_percentual` e `saidas_percentual`,
/// numéricos entre -100 e 100, validados por trigger (bd/10). Só um cenário
/// por empresa pode ser `isBaseline`.
model CashFlowScenario {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId      String   @map("empresa_id") @db.Uuid
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name           String   @map("nome") @db.VarChar(120)
  description    String?  @map("descricao")
  startDate      DateTime @map("data_inicio") @db.Date
  endDate        DateTime @map("data_fim") @db.Date
  /// Caixa no primeiro dia da janela: o ponto de partida do saldo acumulado.
  openingBalance Decimal  @default(0) @map("saldo_inicial") @db.Decimal(18, 2)
  assumptions    Json     @default("{}") @map("premissas")
  isBaseline     Boolean  @default(false) @map("base")
  createdById    String?  @map("criado_por") @db.Uuid
  createdBy      User?    @relation(fields: [createdById], references: [id])
  createdAt      DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  projections CashFlowProjection[]

  @@map("cenario_fluxo_caixa")
}

/// gestao.projecao_fluxo_caixa — movimento digitado dentro de um cenário (RF-104).
///
/// Sempre manual, sempre PREVISTO e sempre dentro da janela do cenário: o que o
/// sistema calcula não passa por aqui (bd/10).
model CashFlowProjection {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId     String           @map("empresa_id") @db.Uuid
  scenarioId    String           @map("cenario_id") @db.Uuid
  scenario      CashFlowScenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  referenceDate DateTime         @map("data_referencia") @db.Date
  type          EntryType        @map("tipo")
  situation     Realization      @default(PREVISTO) @map("situacao")
  categoryId    String?          @map("categoria_financeira_id") @db.Uuid
  category      Category?        @relation(fields: [categoryId], references: [id])
  costCenterId  String?          @map("centro_custo_id") @db.Uuid
  costCenter    CostCenter?      @relation(fields: [costCenterId], references: [id])
  /// Sempre positivo — a direção vem de `type` (PAGAR sai, RECEBER entra).
  amount        Decimal          @map("valor") @db.Decimal(18, 2)
  description   String?          @map("descricao") @db.VarChar(255)
  isManual      Boolean          @default(true) @map("manual")
  createdAt     DateTime         @default(now()) @map("criado_em") @db.Timestamptz(6)

  @@index([scenarioId, referenceDate], map: "ix_projecao_cenario")
  @@map("projecao_fluxo_caixa")
}

/// gestao.alerta_caixa — configuração do aviso de insuficiência (RF-105).
///
/// `bankAccountId` aponta para `gestao.conta_bancaria` (M09, Sprint 10) sem
/// relação declarada: até lá a conta só define de onde vem o saldo inicial, e
/// mapear o modelo inteiro traria um módulo que a API ainda não expõe.
model CashAlert {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId      String   @map("empresa_id") @db.Uuid
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name           String   @map("nome") @db.VarChar(120)
  /// Nulo = caixa da empresa (soma das contas ativas).
  bankAccountId  String?  @map("conta_bancaria_id") @db.Uuid
  minimumBalance Decimal  @default(0) @map("saldo_minimo") @db.Decimal(18, 2)
  /// Horizonte da projeção, em dias (1 a 180 — bd/10).
  daysAhead      Int      @default(7) @map("dias_antecedencia") @db.SmallInt
  isActive       Boolean  @default(true) @map("ativo")
  createdById    String?  @map("criado_por") @db.Uuid
  createdBy      User?    @relation(fields: [createdById], references: [id])
  createdAt      DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  @@map("alerta_caixa")
}

// ---------------------------------------------------------------------------
// M06 — Compras (RF-036 a RF-042)
//
// `pedido_compra` é o documento; `recebimento` é o fato. Como no razão de
// estoque e nas baixas, a projeção não é gravável pela API: o total do pedido, a
// quantidade recebida do item, o status do pedido e as marcas de "gerou
// estoque"/"gerou financeiro" são mantidos por trigger (bd/11), e a role da
// aplicação não tem UPDATE/DELETE sobre `recebimento`/`recebimento_item`.
// ---------------------------------------------------------------------------

/// gestao.pedido_compra — pedido de compra (RF-036 a RF-038, RF-041).
///
/// `number`, `productsAmount` e `totalAmount` são escritos pelo banco:
/// numeração sequencial (`fn_proximo_numero_pedido_compra`) e projeção dos itens
/// com o rateio das despesas (bd/11). A API não os envia.
model PurchaseOrder {
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId          String              @map("empresa_id") @db.Uuid
  branchId           String?             @map("filial_id") @db.Uuid
  branch             Branch?             @relation(fields: [branchId], references: [id])
  number             String              @map("numero") @db.VarChar(30)
  partnerId          String              @map("parceiro_id") @db.Uuid
  partner            Partner             @relation(fields: [partnerId], references: [id])
  /// Usuário que abriu o pedido — é ele que não pode aprová-lo (RN-003).
  requesterId        String?             @map("solicitante_id") @db.Uuid
  requester          User?               @relation("PedidoSolicitante", fields: [requesterId], references: [id])
  buyerId            String?             @map("comprador_id") @db.Uuid
  buyer              Employee?           @relation(fields: [buyerId], references: [id])
  orderDate          DateTime            @default(now()) @map("data_pedido") @db.Date
  expectedDate       DateTime?           @map("data_previsao_entrega") @db.Date
  paymentTermId      String?             @map("condicao_pagamento_id") @db.Uuid
  paymentTerm        PaymentTerm?        @relation(fields: [paymentTermId], references: [id])
  paymentMethodId    String?             @map("forma_pagamento_id") @db.Uuid
  paymentMethod      PaymentMethod?      @relation(fields: [paymentMethodId], references: [id])
  costCenterId       String?             @map("centro_custo_id") @db.Uuid
  costCenter         CostCenter?         @relation(fields: [costCenterId], references: [id])
  categoryId         String?             @map("categoria_financeira_id") @db.Uuid
  category           Category?           @relation(fields: [categoryId], references: [id])
  productsAmount     Decimal             @default(0) @map("valor_produtos") @db.Decimal(18, 2)
  discountAmount     Decimal             @default(0) @map("valor_desconto") @db.Decimal(18, 2)
  freightAmount      Decimal             @default(0) @map("valor_frete") @db.Decimal(18, 2)
  insuranceAmount    Decimal             @default(0) @map("valor_seguro") @db.Decimal(18, 2)
  otherExpenseAmount Decimal             @default(0) @map("valor_outras_despesas") @db.Decimal(18, 2)
  totalAmount        Decimal             @default(0) @map("valor_total") @db.Decimal(18, 2)
  status             PurchaseOrderStatus @default(RASCUNHO) @map("status")
  approvalStatus     ApprovalStatus      @default(NAO_REQUERIDA) @map("status_aprovacao")
  approvedById       String?             @map("aprovado_por") @db.Uuid
  approvedBy         User?               @relation("PedidoAprovador", fields: [approvedById], references: [id])
  approvedAt         DateTime?           @map("aprovado_em") @db.Timestamptz(6)
  note               String?             @map("observacao")
  canceledAt         DateTime?           @map("cancelado_em") @db.Timestamptz(6)
  cancelReason       String?             @map("motivo_cancelamento")
  createdById        String?             @map("criado_por") @db.Uuid
  createdBy          User?               @relation("PedidoCriador", fields: [createdById], references: [id])
  createdAt          DateTime            @default(now()) @map("criado_em") @db.Timestamptz(6)
  updatedAt          DateTime            @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  items            PurchaseOrderItem[]
  receipts         GoodsReceipt[]
  financialEntries FinancialEntry[]
  fiscalDocuments  FiscalDocument[]

  @@unique([companyId, number], map: "uq_pedido_compra_numero")
  @@map("pedido_compra")
}

/// gestao.pedido_compra_item — item negociado do pedido (RF-037).
///
/// `lineAmount`, `apportionedFreight` e `receivedQuantity` são projeção (bd/11):
/// o primeiro sai de quantidade × preço − desconto, o segundo do rateio das
/// despesas do cabeçalho e o terceiro dos recebimentos aceitos.
model PurchaseOrderItem {
  id                 String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId          String         @map("empresa_id") @db.Uuid
  orderId            String         @map("pedido_compra_id") @db.Uuid
  order              PurchaseOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sequence           Int            @map("sequencia") @db.SmallInt
  productId          String?        @map("produto_id") @db.Uuid
  product            Product?       @relation(fields: [productId], references: [id])
  description        String         @map("descricao") @db.VarChar(255)
  quantity           Decimal        @map("quantidade") @db.Decimal(18, 6)
  receivedQuantity   Decimal        @default(0) @map("quantidade_recebida") @db.Decimal(18, 6)
  unitPrice          Decimal        @map("preco_unitario") @db.Decimal(18, 6)
  discountAmount     Decimal        @default(0) @map("valor_desconto") @db.Decimal(18, 2)
  apportionedFreight Decimal        @default(0) @map("valor_frete_rateado") @db.Decimal(18, 2)
  lineAmount         Decimal        @map("valor_total") @db.Decimal(18, 2)
  costCenterId       String?        @map("centro_custo_id") @db.Uuid
  costCenter         CostCenter?    @relation(fields: [costCenterId], references: [id])
  locationId         String?        @map("local_estoque_id") @db.Uuid
  location           StockLocation? @relation(fields: [locationId], references: [id])
  note               String?        @map("observacao")

  receiptItems GoodsReceiptItem[]

  @@unique([orderId, sequence], map: "uq_pedido_compra_item")
  @@map("pedido_compra_item")
}

/// gestao.recebimento — conferência de uma entrega (RF-039/RF-040).
///
/// Append-only: a API tem apenas SELECT e INSERT (bd/11). `hasDivergence`,
/// `generatedStock` e `generatedPayable` são marcas projetadas por trigger — a
/// última, do próprio título gerado, para que não possam mentir.
model GoodsReceipt {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId        String          @map("empresa_id") @db.Uuid
  branchId         String?         @map("filial_id") @db.Uuid
  branch           Branch?         @relation(fields: [branchId], references: [id])
  orderId          String?         @map("pedido_compra_id") @db.Uuid
  order            PurchaseOrder?  @relation(fields: [orderId], references: [id])
  /// Nota que acompanhou a entrega (RF-047). Informada na criação: o cabeçalho
  /// do recebimento é imutável (bd/11), então não há como vinculá-la depois.
  fiscalDocumentId String?         @map("documento_fiscal_id") @db.Uuid
  fiscalDocument   FiscalDocument? @relation(fields: [fiscalDocumentId], references: [id])
  number           String          @map("numero") @db.VarChar(30)
  receivedAt       DateTime        @default(now()) @map("data_recebimento") @db.Timestamptz(6)
  locationId       String?         @map("local_estoque_id") @db.Uuid
  location         StockLocation?  @relation(fields: [locationId], references: [id])
  inspectorId      String?         @map("conferente_id") @db.Uuid
  inspector        User?           @relation("RecebimentoConferente", fields: [inspectorId], references: [id])
  hasDivergence    Boolean         @default(false) @map("possui_divergencia")
  generatedStock   Boolean         @default(false) @map("gerou_estoque")
  generatedPayable Boolean         @default(false) @map("gerou_financeiro")
  note             String?         @map("observacao")
  createdAt        DateTime        @default(now()) @map("criado_em") @db.Timestamptz(6)
  updatedAt        DateTime        @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  items GoodsReceiptItem[]

  @@unique([companyId, number], map: "uq_recebimento_numero")
  @@map("recebimento")
}

/// gestao.recebimento_item — linha conferida (RF-040).
///
/// `orderedQuantity`, `orderedPrice` e `divergenceType` são preenchidos pelo
/// banco a partir do item do pedido: a divergência é apurada contra o que foi
/// pedido, não contra o que quem digita a conferência informa.
model GoodsReceiptItem {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId          String             @map("empresa_id") @db.Uuid
  receiptId          String             @map("recebimento_id") @db.Uuid
  receipt            GoodsReceipt       @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  orderItemId        String?            @map("pedido_compra_item_id") @db.Uuid
  orderItem          PurchaseOrderItem? @relation(fields: [orderItemId], references: [id])
  productId          String?            @map("produto_id") @db.Uuid
  product            Product?           @relation(fields: [productId], references: [id])
  orderedQuantity    Decimal?           @map("quantidade_pedida") @db.Decimal(18, 6)
  receivedQuantity   Decimal            @map("quantidade_recebida") @db.Decimal(18, 6)
  orderedPrice       Decimal?           @map("preco_pedido") @db.Decimal(18, 6)
  documentPrice      Decimal?           @map("preco_documento") @db.Decimal(18, 6)
  /// Coluna gerada pelo banco (recebida − pedida): somente leitura.
  quantityDivergence Decimal?           @map("divergencia_quantidade") @db.Decimal(18, 6)
  /// QUANTIDADE | PRECO | AMBOS | NENHUMA — apurado por trigger (bd/11).
  divergenceType     String?            @map("tipo_divergencia") @db.VarChar(40)
  /// Linha recusada na conferência não abate o pedido nem entra no estoque.
  accepted           Boolean            @default(true) @map("aceito")
  note               String?            @map("observacao")

  @@map("recebimento_item")
}

// ---------------------------------------------------------------------------
// M07 — Documentos Fiscais (RF-043 a RF-050)
//
// A diferença em relação a todos os módulos anteriores: o documento fiscal não é
// um fato nosso. Pedido, recebimento e título nascem aqui e por isso o banco os
// calcula; a nota nasce no emitente. Os valores dela são **informados** e o banco
// não os recalcula — ele exige que a soma dos itens feche com o total declarado
// (bd/12, conferência no commit). Recalcular seria reescrever documento de
// terceiro para que ele parecesse correto.
//
// O que continua sendo projeção do modelo: `status` (máquina de estados do
// processamento), `processadoEm`, e as marcas `generatedStock`/`generatedPayable`
// — estas últimas cobrem tanto o efeito gerado pela própria nota quanto o gerado
// pelo recebimento que a referencia.
// ---------------------------------------------------------------------------

/// gestao.documento_fiscal — nota recebida e o controle do seu processamento
/// (RF-043 a RF-050).
model FiscalDocument {
  id                 String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId          String               @map("empresa_id") @db.Uuid
  branchId           String?              @map("filial_id") @db.Uuid
  branch             Branch?              @relation(fields: [branchId], references: [id])
  model              FiscalDocumentModel  @default(NFE) @map("modelo")
  /// 44 dígitos da NF-e/NFC-e. Nula no que não tem chave (NFS-e, recibo) — a
  /// identidade, aí, é modelo + número + série + emitente (bd/12).
  accessKey          String?              @map("chave_acesso") @db.VarChar(44)
  number             String               @map("numero") @db.VarChar(20)
  series             String?              @map("serie") @db.VarChar(5)
  /// 0 = entrada, 1 = saída (tpNF do XML).
  operationType      String?              @map("tipo_operacao") @db.Char(1)
  operationNature    String?              @map("natureza_operacao") @db.VarChar(120)
  issuedAt           DateTime             @map("data_emissao") @db.Timestamptz(6)
  movedAt            DateTime?            @map("data_entrada_saida") @db.Timestamptz(6)
  issuerPartnerId    String?              @map("emitente_parceiro_id") @db.Uuid
  issuerPartner      Partner?             @relation("NotaEmitente", fields: [issuerPartnerId], references: [id])
  issuerTaxId        String?              @map("emitente_cnpj_cpf") @db.VarChar(14)
  issuerName         String?              @map("emitente_nome") @db.VarChar(255)
  recipientPartnerId String?              @map("destinatario_parceiro_id") @db.Uuid
  recipientPartner   Partner?             @relation("NotaDestinatario", fields: [recipientPartnerId], references: [id])
  recipientTaxId     String?              @map("destinatario_cnpj_cpf") @db.VarChar(14)
  recipientName      String?              @map("destinatario_nome") @db.VarChar(255)
  productsAmount     Decimal              @default(0) @map("valor_produtos") @db.Decimal(18, 2)
  discountAmount     Decimal              @default(0) @map("valor_desconto") @db.Decimal(18, 2)
  freightAmount      Decimal              @default(0) @map("valor_frete") @db.Decimal(18, 2)
  insuranceAmount    Decimal              @default(0) @map("valor_seguro") @db.Decimal(18, 2)
  otherExpenseAmount Decimal              @default(0) @map("valor_outras_despesas") @db.Decimal(18, 2)
  totalAmount        Decimal              @default(0) @map("valor_total") @db.Decimal(18, 2)
  icmsAmount         Decimal              @default(0) @map("valor_icms") @db.Decimal(18, 2)
  icmsStAmount       Decimal              @default(0) @map("valor_icms_st") @db.Decimal(18, 2)
  ipiAmount          Decimal              @default(0) @map("valor_ipi") @db.Decimal(18, 2)
  pisAmount          Decimal              @default(0) @map("valor_pis") @db.Decimal(18, 2)
  cofinsAmount       Decimal              @default(0) @map("valor_cofins") @db.Decimal(18, 2)
  issAmount          Decimal              @default(0) @map("valor_iss") @db.Decimal(18, 2)
  origin             FiscalDocumentOrigin @default(UPLOAD_MANUAL) @map("origem")
  /// Identificador do documento na origem — chave de idempotência da coleta
  /// automática (RF-050): o coletor que repete o lote não cria segundo registro.
  originReference    String?              @map("origem_referencia") @db.VarChar(120)
  collectedAt        DateTime?            @map("coletado_em") @db.Timestamptz(6)
  status             FiscalDocumentStatus @default(RECEBIDO) @map("status")
  /// XML recebido, na íntegra. Imutável depois de gravado (bd/12): reprocessar é
  /// ler outra vez o mesmo conteúdo, não substituí-lo.
  xmlContent         String?              @map("xml_conteudo")
  xmlHash            String?              @map("xml_hash") @db.VarChar(64)
  xmlStorageUrl      String?              @map("xml_storage_url")
  danfeStorageUrl    String?              @map("danfe_storage_url")
  attempts           Int                  @default(0) @map("tentativas_processamento") @db.SmallInt
  processingError    String?              @map("erro_processamento")
  processedAt        DateTime?            @map("processado_em") @db.Timestamptz(6)
  duplicateOfId      String?              @map("duplicado_de_id") @db.Uuid
  duplicateOf        FiscalDocument?      @relation("NotaDuplicata", fields: [duplicateOfId], references: [id])
  purchaseOrderId    String?              @map("pedido_compra_id") @db.Uuid
  purchaseOrder      PurchaseOrder?       @relation(fields: [purchaseOrderId], references: [id])
  generatedStock     Boolean              @default(false) @map("gerou_estoque")
  generatedPayable   Boolean              @default(false) @map("gerou_financeiro")
  metadata           Json                 @default("{}") @map("metadados")
  createdById        String?              @map("criado_por") @db.Uuid
  createdBy          User?                @relation(fields: [createdById], references: [id])
  createdAt          DateTime             @default(now()) @map("criado_em") @db.Timestamptz(6)
  updatedAt          DateTime             @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  items            FiscalDocumentItem[]
  duplicates       FiscalDocument[]     @relation("NotaDuplicata")
  receipts         GoodsReceipt[]
  financialEntries FinancialEntry[]
  stockMovements   StockMovement[]

  @@map("documento_fiscal")
}

/// gestao.documento_fiscal_item — linha da nota, com tributos (RF-045).
///
/// `productId` é o vínculo com o catálogo (RF-047) e a única coluna que ainda
/// muda depois do processamento — até a nota dar entrada no estoque, quando ela
/// também congela (bd/12).
model FiscalDocumentItem {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId      String         @map("empresa_id") @db.Uuid
  documentId     String         @map("documento_fiscal_id") @db.Uuid
  document       FiscalDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  sequence       Int            @map("sequencia") @db.SmallInt
  productId      String?        @map("produto_id") @db.Uuid
  product        Product?       @relation(fields: [productId], references: [id])
  /// Código do item no catálogo do emitente (cProd) — é por ele que o vínculo
  /// com o nosso produto é sugerido na próxima nota do mesmo fornecedor.
  supplierCode   String?        @map("codigo_produto_origem") @db.VarChar(60)
  description    String         @map("descricao") @db.VarChar(255)
  ncm            String?        @db.VarChar(8)
  cest           String?        @db.VarChar(7)
  cfop           String?        @db.VarChar(4)
  unit           String?        @map("unidade") @db.VarChar(6)
  quantity       Decimal        @map("quantidade") @db.Decimal(18, 6)
  unitPrice      Decimal        @map("valor_unitario") @db.Decimal(18, 6)
  discountAmount Decimal        @default(0) @map("valor_desconto") @db.Decimal(18, 2)
  freightAmount  Decimal        @default(0) @map("valor_frete") @db.Decimal(18, 2)
  lineAmount     Decimal        @map("valor_total") @db.Decimal(18, 2)
  icmsCst        String?        @map("cst_icms") @db.VarChar(4)
  icmsBase       Decimal        @default(0) @map("base_calculo_icms") @db.Decimal(18, 2)
  icmsRate       Decimal        @default(0) @map("aliquota_icms") @db.Decimal(9, 6)
  icmsAmount     Decimal        @default(0) @map("valor_icms") @db.Decimal(18, 2)
  icmsStAmount   Decimal        @default(0) @map("valor_icms_st") @db.Decimal(18, 2)
  ipiAmount      Decimal        @default(0) @map("valor_ipi") @db.Decimal(18, 2)
  pisAmount      Decimal        @default(0) @map("valor_pis") @db.Decimal(18, 2)
  cofinsAmount   Decimal        @default(0) @map("valor_cofins") @db.Decimal(18, 2)

  @@unique([documentId, sequence], map: "uq_documento_fiscal_item")
  @@map("documento_fiscal_item")
}

// ---------------------------------------------------------------------------
// M16 — Auditoria
// ---------------------------------------------------------------------------

/// gestao.auditoria — trilha append-only (RF-114 a RF-118).
///
/// Tabela particionada por mês; a PK inclui a chave de particionamento. Não há
/// relação declarada com Company/User de propósito: a trilha precisa sobreviver
/// à remoção do que ela descreve, por isso guarda `userName` desnormalizado.
///
/// Somente leitura pela API. UPDATE e DELETE são barrados no banco por trigger
/// (bd/03) e por ausência de privilégio (bd/05) — não exponha mutação aqui.
model AuditLog {
  id            BigInt     @default(autoincrement())
  companyId     String?    @map("empresa_id") @db.Uuid
  userId        String?    @map("usuario_id") @db.Uuid
  userName      String?    @map("usuario_nome") @db.VarChar(255)
  event         AuditEvent @map("evento")
  entity        String     @map("entidade") @db.VarChar(60)
  entityId      String?    @map("entidade_id") @db.Uuid
  previousValue Json?      @map("valor_anterior")
  currentValue  Json?      @map("valor_posterior")
  changedFields String[]   @map("campos_alterados")
  origin        String?    @map("origem") @db.VarChar(40)
  ip            String?    @db.Inet
  userAgent     String?    @map("user_agent")
  correlationId String?    @map("correlation_id") @db.VarChar(60)
  note          String?    @map("observacao")
  occurredAt    DateTime   @default(now()) @map("ocorrido_em") @db.Timestamptz(6)

  @@id([id, occurredAt])
  @@index([companyId, occurredAt(sort: Desc)], map: "ix_auditoria_empresa_periodo")
  @@index([companyId, entity, entityId, occurredAt(sort: Desc)], map: "ix_auditoria_entidade")
  @@map("auditoria")
}

/// gestao.alcada_aprovador — quem aprova a alçada: um perfil OU um usuário.
model ApprovalApprover {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  thresholdId String            @map("alcada_id") @db.Uuid
  threshold   ApprovalThreshold @relation(fields: [thresholdId], references: [id], onDelete: Cascade)
  userId      String?           @map("usuario_id") @db.Uuid
  user        User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId      String?           @map("perfil_id") @db.Uuid
  role        Role?             @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@map("alcada_aprovador")
}

// ---------------------------------------------------------------------------
// M09 — Bancos, Pagamentos e Recebimentos (RF-059 a RF-070) — Sprint 10
//
// Três camadas, e elas não se misturam:
//   1. cadastro — `Provider` (catálogo global), `IntegrationCredential`
//      (segredo cifrado por empresa) e `CompanyBankAccount`;
//   2. ordem de pagamento — `PaymentTransaction`, com máquina de estados no
//      banco (bd/13) e três chaves de unicidade contra movimentação duplicada;
//   3. infraestrutura — `IdempotencyRecord`, `WebhookEvent` e `JobExecution`,
//      as três com RLS estrita (bd/13 §10).
//
// M10 entra aqui só com o que a importação de extrato (RF-060) precisa:
// `BankStatementImport` e `BankTransaction`. A conciliação é a Sprint 11.
// ---------------------------------------------------------------------------

/// Natureza da integração externa (RF-061) — `enum_categoria_provider`.
enum ProviderCategory {
  BANCARIO
  PIX
  BOLETO
  FISCAL
  OCR
  EMAIL
  CONTABIL
  ARMAZENAMENTO
  OUTRO

  @@map("enum_categoria_provider")
}

/// Direção do dinheiro (RF-062) — `enum_sentido_transacao`.
enum TransactionDirection {
  DEBITO
  CREDITO

  @@map("enum_sentido_transacao")
}

/// Situação da ordem de pagamento (RF-062 a RF-065) — `enum_status_transacao`.
///
/// As transições válidas são aplicadas por trigger (bd/13): CRIADA/AGENDADA
/// abrem, ENFILEIRADA→ENVIADA→CONFIRMADA é o caminho feliz, FALHA volta para a
/// fila enquanto houver tentativa e CANCELADA/ESTORNADA/EXPIRADA são terminais.
enum PaymentTransactionStatus {
  CRIADA
  AGENDADA
  ENFILEIRADA
  ENVIADA
  PROCESSANDO
  CONFIRMADA
  FALHA
  CANCELADA
  ESTORNADA
  EXPIRADA

  @@map("enum_status_transacao")
}

/// Situação de um job da fila e de um webhook recebido — `enum_status_job`.
enum JobStatus {
  PENDENTE
  PROCESSANDO
  CONCLUIDO
  FALHA
  CANCELADO
  AGENDADO

  @@map("enum_status_job")
}

/// Situação da conciliação de um movimento bancário — `enum_status_conciliacao`.
/// Escrita só na Sprint 11 (M10); aqui a importação nasce NAO_CONCILIADO.
enum ReconciliationStatus {
  NAO_CONCILIADO
  SUGERIDO
  CONCILIADO
  DIVERGENTE
  IGNORADO

  @@map("enum_status_conciliacao")
}

/// gestao.provider — catálogo global de integrações (RF-061).
///
/// Não tem `empresa_id`: é o mesmo banco para todo mundo. Somente leitura pela
/// API (bd/13 revoga a escrita) — deixar uma empresa editar provedores
/// permitiria apontar o pagamento de outra para um endpoint próprio.
model Provider {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code         String           @unique(map: "uq_provider_codigo") @map("codigo") @db.VarChar(40)
  name         String           @map("nome") @db.VarChar(120)
  category     ProviderCategory @map("categoria")
  description  String?          @map("descricao")
  /// O que este provedor sabe fazer: `{"pix":true,"cancelamento":false,...}`.
  /// É daqui que sai `PaymentTransaction.cancellable` (RF-065).
  capabilities Json             @default("{}") @map("capacidades")
  isActive     Boolean          @default(true) @map("ativo")
  createdAt    DateTime         @default(now()) @map("criado_em") @db.Timestamptz(6)

  credentials IntegrationCredential[]

  @@map("provider")
}

/// gestao.credencial_integracao — segredo do provedor, por empresa e ambiente.
///
/// `secret` é o payload cifrado (AES-256-GCM) e **nunca** sai pela API: não há
/// endpoint que o devolva e nenhum select do módulo o projeta (RNF-003/RNF-005).
model IntegrationCredential {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId      String    @map("empresa_id") @db.Uuid
  providerId     String    @map("provider_id") @db.Uuid
  provider       Provider  @relation(fields: [providerId], references: [id])
  name           String    @map("nome") @db.VarChar(120)
  environment    String    @default("PRODUCAO") @map("ambiente") @db.VarChar(20)
  secret         Bytes     @map("credenciais_cifradas")
  kmsKey         String?   @map("chave_kms") @db.VarChar(255)
  certificateRef String?   @map("certificado_ref") @db.VarChar(255)
  expiresAt      DateTime? @map("expira_em") @db.Timestamptz(6)
  isActive       Boolean   @default(true) @map("ativo")
  createdAt      DateTime  @default(now()) @map("criado_em") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  bankAccounts CompanyBankAccount[]

  @@unique([companyId, providerId, environment, name], map: "uq_credencial")
  @@map("credencial_integracao")
}

/// gestao.conta_bancaria — conta da empresa no banco (RF-059).
///
/// Não confundir com `BankAccount` (`gestao.dado_bancario`), que é a conta de
/// **terceiro** para onde a empresa credita — funcionário (RF-013) ou parceiro
/// (RF-024). Esta é a conta de onde o dinheiro sai.
///
/// `currentBalance` é o saldo informado pelo banco no último extrato importado,
/// não um saldo contábil: quem o move é o trigger de `BankStatementImport`
/// (bd/13 §9). A divergência entre ele e as baixas lançadas é exatamente o que a
/// conciliação (M10) precisa enxergar.
model CompanyBankAccount {
  id             String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId      String                 @map("empresa_id") @db.Uuid
  branchId       String?                @map("filial_id") @db.Uuid
  branch         Branch?                @relation(fields: [branchId], references: [id])
  providerId     String?                @map("provider_id") @db.Uuid
  credentialId   String?                @map("credencial_id") @db.Uuid
  credential     IntegrationCredential? @relation(fields: [credentialId], references: [id])
  description    String                 @map("descricao") @db.VarChar(120)
  bankCode       String                 @map("banco_codigo") @db.VarChar(5)
  bankName       String?                @map("banco_nome") @db.VarChar(120)
  agency         String                 @map("agencia") @db.VarChar(10)
  agencyDigit    String?                @map("agencia_digito") @db.VarChar(2)
  account        String                 @map("conta") @db.VarChar(20)
  accountDigit   String?                @map("conta_digito") @db.VarChar(2)
  accountType    String                 @default("CORRENTE") @map("tipo_conta") @db.VarChar(20)
  pixKey         String?                @map("chave_pix") @db.VarChar(140)
  openingBalance Decimal                @default(0) @map("saldo_inicial") @db.Decimal(18, 2)
  currentBalance Decimal                @default(0) @map("saldo_atual") @db.Decimal(18, 2)
  balanceDate    DateTime?              @map("data_saldo") @db.Date
  allowsPayment  Boolean                @default(true) @map("permite_pagamento")
  allowsReceipt  Boolean                @default(true) @map("permite_recebimento")
  isDefault      Boolean                @default(false) @map("padrao")
  isActive       Boolean                @default(true) @map("ativo")
  note           String?                @map("observacao")
  createdAt      DateTime               @default(now()) @map("criado_em") @db.Timestamptz(6)
  updatedAt      DateTime               @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  transactions     PaymentTransaction[]
  statementImports BankStatementImport[]
  bankTransactions BankTransaction[]

  @@unique([companyId, bankCode, agency, account], map: "uq_conta_bancaria")
  @@map("conta_bancaria")
}

/// gestao.idempotencia — reserva de uma operação por chave (RF-067).
///
/// Registro imutável: depois de gravada, a linha só aceita o preenchimento do
/// resultado, e uma vez só (bd/13 §4). É isso que faz a segunda chamada devolver
/// o resultado da primeira em vez de executar de novo — RN-004/RN-005.
model IdempotencyRecord {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId    String?   @map("empresa_id") @db.Uuid
  scope        String    @map("escopo") @db.VarChar(60)
  key          String    @map("chave") @db.VarChar(255)
  /// SHA-256 do corpo da requisição: mesma chave com corpo diferente é conflito,
  /// não repetição (RF-067).
  requestHash  String?   @map("request_hash") @db.VarChar(64)
  resourceType String?   @map("recurso_tipo") @db.VarChar(60)
  resourceId   String?   @map("recurso_id") @db.Uuid
  response     Json?     @map("resposta")
  statusCode   Int?      @map("status_http") @db.SmallInt
  userId       String?   @map("usuario_id") @db.Uuid
  expiresAt    DateTime? @map("expira_em") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("criado_em") @db.Timestamptz(6)

  @@map("idempotencia")
}

/// gestao.transacao_pagamento — a ordem de pagamento ou recebimento
/// (RF-062 a RF-065, RF-068, RF-070).
///
/// Três chaves de unicidade empilhadas contra movimentação duplicada (RN-004):
/// `idempotencyKey` por empresa, `externalId` por provedor e a baixa única por
/// transação (bd/13 §6). Um retry da API, um reenvio do worker e um webhook
/// repetido batem, cada um, numa delas.
model PaymentTransaction {
  id                 String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId          String                   @map("empresa_id") @db.Uuid
  bankAccountId      String                   @map("conta_bancaria_id") @db.Uuid
  bankAccount        CompanyBankAccount       @relation(fields: [bankAccountId], references: [id])
  providerId         String?                  @map("provider_id") @db.Uuid
  installmentId      String?                  @map("titulo_parcela_id") @db.Uuid
  installment        FinancialInstallment?    @relation(fields: [installmentId], references: [id])
  direction          TransactionDirection     @map("sentido")
  method             PaymentMethodType        @map("metodo")
  status             PaymentTransactionStatus @default(CRIADA) @map("status")
  amount             Decimal                  @map("valor") @db.Decimal(18, 2)
  description        String?                  @map("descricao") @db.VarChar(255)
  scheduledFor       DateTime?                @map("data_agendamento") @db.Date
  executedAt         DateTime?                @map("data_execucao") @db.Timestamptz(6)
  confirmedAt        DateTime?                @map("data_confirmacao") @db.Timestamptz(6)
  payeeName          String?                  @map("favorecido_nome") @db.VarChar(255)
  payeeDocument      String?                  @map("favorecido_documento") @db.VarChar(14)
  payeeBankCode      String?                  @map("favorecido_banco") @db.VarChar(5)
  payeeAgency        String?                  @map("favorecido_agencia") @db.VarChar(10)
  payeeAccount       String?                  @map("favorecido_conta") @db.VarChar(20)
  pixKey             String?                  @map("chave_pix") @db.VarChar(140)
  barcode            String?                  @map("codigo_barras") @db.VarChar(60)
  idempotencyKey     String                   @map("idempotency_key") @db.VarChar(255)
  /// Id da operação no provedor (RF-068) — único por provider.
  externalId         String?                  @map("identificador_externo") @db.VarChar(140)
  endToEndId         String?                  @map("end_to_end_id") @db.VarChar(60)
  /// Payloads sem segredo: o adaptador remove credenciais antes de gravar.
  requestPayload     Json?                    @map("payload_envio")
  responsePayload    Json?                    @map("payload_retorno")
  errorCode          String?                  @map("codigo_erro") @db.VarChar(60)
  errorMessage       String?                  @map("mensagem_erro")
  attempts           Int                      @default(0) @map("tentativas") @db.SmallInt
  maxAttempts        Int                      @default(5) @map("max_tentativas") @db.SmallInt
  nextAttemptAt      DateTime?                @map("proxima_tentativa_em") @db.Timestamptz(6)
  cancellable        Boolean                  @default(false) @map("cancelavel")
  cancelledAt        DateTime?                @map("cancelada_em") @db.Timestamptz(6)
  cancellationReason String?                  @map("motivo_cancelamento")
  reversalOfId       String?                  @map("estorno_de_id") @db.Uuid
  reversalOf         PaymentTransaction?      @relation("TransacaoEstorno", fields: [reversalOfId], references: [id])
  requestedById      String?                  @map("solicitado_por") @db.Uuid
  requestedBy        User?                    @relation(fields: [requestedById], references: [id])
  createdAt          DateTime                 @default(now()) @map("criado_em") @db.Timestamptz(6)
  updatedAt          DateTime                 @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  reversals   PaymentTransaction[] @relation("TransacaoEstorno")
  settlements Settlement[]

  @@unique([companyId, idempotencyKey], map: "uq_transacao_idempotency")
  @@map("transacao_pagamento")
}

/// gestao.webhook_evento — notificação recebida do provedor (RF-066).
///
/// Guardado antes de processado, e guardado mesmo quando a assinatura não
/// confere: um evento forjado é a única evidência de que alguém tentou. Só não
/// vira efeito — bd/13 §7 recusa qualquer status de processamento nesse caso.
model WebhookEvent {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId      String?   @map("empresa_id") @db.Uuid
  providerId     String?   @map("provider_id") @db.Uuid
  eventType      String    @map("evento_tipo") @db.VarChar(80)
  externalId     String?   @map("evento_id_externo") @db.VarChar(160)
  signature      String?   @map("assinatura")
  signatureValid Boolean?  @map("assinatura_valida")
  payload        Json      @map("payload")
  /// SHA-256 do corpo: dedupe do provedor que não manda id de evento (bd/13 §7).
  payloadHash    String?   @map("payload_hash") @db.VarChar(64)
  headers        Json?     @map("headers")
  status         JobStatus @default(PENDENTE) @map("status")
  attempts       Int       @default(0) @map("tentativas") @db.SmallInt
  nextAttemptAt  DateTime? @map("proxima_tentativa_em") @db.Timestamptz(6)
  processedAt    DateTime? @map("processado_em") @db.Timestamptz(6)
  error          String?   @map("erro")
  transactionId  String?   @map("transacao_pagamento_id") @db.Uuid
  receivedAt     DateTime  @default(now()) @map("recebido_em") @db.Timestamptz(6)

  @@map("webhook_evento")
}

/// gestao.job_execucao — a fila (RF-069/RF-070, RN-011).
///
/// Fila no próprio banco, e não em Redis, por uma razão de correção: enfileirar
/// participa da mesma transação que grava a ordem de pagamento. Um job que só
/// existe se a transação confirmar não dispara sobre um pagamento que foi
/// revertido — e o inverso, um pagamento gravado cujo job se perdeu, também não
/// acontece. Trocar o driver por BullMQ depois é trocar `JobQueueService`; o
/// contrato dos handlers não muda.
model JobExecution {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId      String?   @map("empresa_id") @db.Uuid
  queue          String    @map("fila") @db.VarChar(60)
  name           String    @map("nome") @db.VarChar(120)
  payload        Json      @default("{}") @map("payload")
  status         JobStatus @default(PENDENTE) @map("status")
  attempts       Int       @default(0) @map("tentativas") @db.SmallInt
  maxAttempts    Int       @default(5) @map("max_tentativas") @db.SmallInt
  /// Dedupe do enfileiramento: o mesmo job pedido duas vezes é um job só
  /// enquanto não terminar (índice parcial `ux_job_idempotencia`).
  idempotencyKey String?   @map("chave_idempotencia") @db.VarChar(255)
  scheduledFor   DateTime? @default(now()) @map("agendado_para") @db.Timestamptz(6)
  startedAt      DateTime? @map("iniciado_em") @db.Timestamptz(6)
  finishedAt     DateTime? @map("finalizado_em") @db.Timestamptz(6)
  durationMs     Int?      @map("duracao_ms")
  error          String?   @map("erro")
  lastErrorAt    DateTime? @map("ultimo_erro_em") @db.Timestamptz(6)
  correlationId  String?   @map("correlation_id") @db.VarChar(60)
  createdAt      DateTime  @default(now()) @map("criado_em") @db.Timestamptz(6)

  @@map("job_execucao")
}

/// gestao.extrato_importacao — um arquivo de extrato que entrou (RF-060).
///
/// `fileHash` é único por conta: o mesmo arquivo não entra duas vezes. O saldo
/// da conta segue daqui (bd/13 §9).
model BankStatementImport {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId      String             @map("empresa_id") @db.Uuid
  bankAccountId  String             @map("conta_bancaria_id") @db.Uuid
  bankAccount    CompanyBankAccount @relation(fields: [bankAccountId], references: [id])
  format         String             @map("formato") @db.VarChar(20)
  fileName       String?            @map("nome_arquivo") @db.VarChar(255)
  fileHash       String?            @map("hash_arquivo") @db.VarChar(64)
  periodStart    DateTime?          @map("periodo_inicio") @db.Date
  periodEnd      DateTime?          @map("periodo_fim") @db.Date
  openingBalance Decimal?           @map("saldo_inicial") @db.Decimal(18, 2)
  closingBalance Decimal?           @map("saldo_final") @db.Decimal(18, 2)
  totalCount     Int                @default(0) @map("quantidade_registros")
  importedCount  Int                @default(0) @map("quantidade_importada")
  duplicateCount Int                @default(0) @map("quantidade_duplicada")
  status         JobStatus          @default(PENDENTE) @map("status")
  error          String?            @map("erro")
  importedById   String?            @map("importado_por") @db.Uuid
  importedBy     User?              @relation(fields: [importedById], references: [id])
  createdAt      DateTime           @default(now()) @map("criado_em") @db.Timestamptz(6)

  transactions BankTransaction[]

  @@unique([bankAccountId, fileHash], map: "uq_extrato_hash")
  @@map("extrato_importacao")
}

/// gestao.transacao_bancaria — linha do extrato (RF-060).
///
/// Fato consumado do banco: imutável depois de gravada, exceto o par
/// (`reconciliationStatus`, `metadata`), que é da conciliação (bd/13 §9).
/// `externalId` é o FITID do OFX — a dedupe da reimportação do mesmo período.
model BankTransaction {
  id                   String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId            String               @map("empresa_id") @db.Uuid
  bankAccountId        String               @map("conta_bancaria_id") @db.Uuid
  bankAccount          CompanyBankAccount   @relation(fields: [bankAccountId], references: [id])
  statementImportId    String?              @map("extrato_importacao_id") @db.Uuid
  statementImport      BankStatementImport? @relation(fields: [statementImportId], references: [id])
  movementDate         DateTime             @map("data_movimento") @db.Date
  postedDate           DateTime?            @map("data_lancamento") @db.Date
  direction            TransactionDirection @map("sentido")
  amount               Decimal              @map("valor") @db.Decimal(18, 2)
  balanceAfter         Decimal?             @map("saldo_apos") @db.Decimal(18, 2)
  description          String?              @map("descricao") @db.VarChar(255)
  document             String?              @map("documento") @db.VarChar(60)
  externalId           String?              @map("identificador_externo") @db.VarChar(140)
  counterpartName      String?              @map("contraparte_nome") @db.VarChar(255)
  counterpartDocument  String?              @map("contraparte_documento") @db.VarChar(14)
  reconciliationStatus ReconciliationStatus @default(NAO_CONCILIADO) @map("status_conciliacao")
  metadata             Json                 @default("{}") @map("metadados")
  createdAt            DateTime             @default(now()) @map("criado_em") @db.Timestamptz(6)
  updatedAt            DateTime             @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  reconciliations Reconciliation[]

  @@map("transacao_bancaria")
}

// ---------------------------------------------------------------------------
// M10 — Conciliação Bancária (RF-071 a RF-077)
//
// O extrato (M09) diz o que o banco fez; o título diz o que nós lançamos. A
// conciliação é a afirmação de que uma linha do extrato **é** um lançamento
// nosso — e o registro de quando os dois não fecham (RF-076).
//
// Ela nunca reescreve o movimento bancário nem a baixa: `transacao_bancaria` é
// fato consumado do banco (bd/13 §9) e `titulo_baixa` é append-only (bd/09). O
// vínculo mora numa terceira tabela, e é ela que carrega origem, score,
// diferença e o histórico de quem confirmou e quem desfez (RF-077).
// ---------------------------------------------------------------------------

/// Como o vínculo nasceu (RF-073/RF-074/RF-075) — `enum_origem_conciliacao`.
///
/// MANUAL é decisão de gente; AUTOMATICA_EXATA é a correspondência que dispensa
/// regra (mesmo valor, mesma janela, um único candidato); AUTOMATICA_REGRA vem
/// de `regra_conciliacao`; IMPORTACAO é o vínculo que já veio pronto do arquivo.
enum ReconciliationOrigin {
  MANUAL
  AUTOMATICA_REGRA
  AUTOMATICA_EXATA
  IMPORTACAO

  @@map("enum_origem_conciliacao")
}

/// gestao.regra_conciliacao — o que a empresa considera correspondência
/// automática (RF-075).
///
/// `conditions` e `actions` são JSON porque o conjunto de critérios cresce sem
/// migration; o que **não** é livre é a semântica: o motor só entende as chaves
/// documentadas em `ReconciliationRuleConditions`/`Actions`, e recusa o resto na
/// validação do DTO. Regra que ninguém entende é regra que concilia errado.
///
/// `priority` decide o desempate: menor número decide primeiro, e a primeira
/// regra que casa encerra a avaliação daquele movimento.
model ReconciliationRule {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId      String   @map("empresa_id") @db.Uuid
  name           String   @map("nome") @db.VarChar(120)
  priority       Int      @default(100) @map("prioridade") @db.SmallInt
  /// `{"descriptionContains":"TARIFA","direction":"DEBITO","maxAmount":"50.00"}`
  conditions     Json     @map("condicoes")
  /// `{"autoReconcile":true,"minScore":"90.00"}`
  actions        Json     @map("acoes")
  /// Diferença de valor aceita entre o movimento e a parcela, em reais.
  valueTolerance Decimal  @default(0) @map("tolerancia_valor") @db.Decimal(18, 2)
  /// Janela de dias entre a data do movimento e o vencimento da parcela.
  dayTolerance   Int      @default(3) @map("tolerancia_dias") @db.SmallInt
  isActive       Boolean  @default(true) @map("ativo")
  createdAt      DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  reconciliations Reconciliation[]

  @@unique([companyId, name], map: "uq_regra_conciliacao_nome")
  @@map("regra_conciliacao")
}

/// gestao.conciliacao — o vínculo entre a linha do extrato e o lançamento
/// interno (RF-073 a RF-077).
///
/// Append-only como a baixa: desfazer é preencher `undoneAt`, nunca apagar —
/// o histórico de RF-077 é a própria tabela, e uma conciliação errada que some
/// leva junto a evidência de que ela existiu. O banco recusa o DELETE (bd/14).
///
/// A soma das conciliações vivas de um movimento nunca passa do valor dele
/// (trigger em bd/14): é isso que permite um crédito único quitar três parcelas
/// sem que a quarta entre por engano.
///
/// `settlementId`, `paymentTransactionId` e os autores são escalares sem
/// relação de propósito — mesma razão de `Settlement.bankAccountId`: ninguém
/// navega a partir daqui, e cada relação inversa a mais é um modelo a mais
/// carregado por engano num include.
model Reconciliation {
  id                   String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId            String                @map("empresa_id") @db.Uuid
  bankTransactionId    String                @map("transacao_bancaria_id") @db.Uuid
  bankTransaction      BankTransaction       @relation(fields: [bankTransactionId], references: [id], onDelete: Cascade)
  installmentId        String?               @map("titulo_parcela_id") @db.Uuid
  installment          FinancialInstallment? @relation(fields: [installmentId], references: [id])
  settlementId         String?               @map("titulo_baixa_id") @db.Uuid
  paymentTransactionId String?               @map("transacao_pagamento_id") @db.Uuid
  ruleId               String?               @map("regra_conciliacao_id") @db.Uuid
  rule                 ReconciliationRule?   @relation(fields: [ruleId], references: [id])
  origin               ReconciliationOrigin  @default(MANUAL) @map("origem")
  /// Confiança da sugestão, de 0 a 100 (RF-073). Nulo em vínculo manual.
  score                Decimal?              @map("score") @db.Decimal(5, 2)
  reconciledAmount     Decimal               @map("valor_conciliado") @db.Decimal(18, 2)
  /// Movimento menos lançamento. Com sinal: sobra e falta são divergências
  /// diferentes para quem investiga (RF-076).
  difference           Decimal               @default(0) @map("diferenca") @db.Decimal(18, 2)
  hasDivergence        Boolean               @default(false) @map("possui_divergencia")
  justification        String?               @map("justificativa")
  /// Falso enquanto é só sugestão (RF-073); verdadeiro quando alguém — ou uma
  /// regra com `autoReconcile` — assumiu o vínculo.
  confirmed            Boolean               @default(false) @map("confirmada")
  confirmedById        String?               @map("confirmada_por") @db.Uuid
  confirmedAt          DateTime?             @map("confirmada_em") @db.Timestamptz(6)
  undoneAt             DateTime?             @map("desfeita_em") @db.Timestamptz(6)
  undoneById           String?               @map("desfeita_por") @db.Uuid
  undoReason           String?               @map("motivo_desfazimento")
  createdAt            DateTime              @default(now()) @map("criado_em") @db.Timestamptz(6)

  @@map("conciliacao")
}

// ---------------------------------------------------------------------------
// M13 — OCR e Automação de Documentos (RF-095 a RF-100) — Sprint 12
//
// O processamento não lança nada: produz uma leitura com confiança e sugestões,
// e quem cria título, reembolso ou nota continua sendo M08, M03 e M07, a partir
// de uma decisão humana (RF-099). Ver bd/15 para as restrições e triggers.
// ---------------------------------------------------------------------------

/// Situação da leitura automática (`enum_status_ocr`, bd/01).
/// Transições válidas em bd/15 §4 — a API não escreve status fora delas.
enum OcrStatus {
  PENDENTE
  PROCESSANDO
  PROCESSADO
  ERRO
  VALIDADO
  REJEITADO

  @@map("enum_status_ocr")
}

/// gestao.ocr_processamento — leitura de um documento e o que se decidiu sobre
/// ela (RF-095 a RF-100). Append-only: rejeitar é status, não DELETE (bd/15 §7).
model OcrProcessing {
  id                       String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId                String         @map("empresa_id") @db.Uuid
  documentId               String         @map("documento_id") @db.Uuid
  document                 StoredDocument @relation(fields: [documentId], references: [id])
  providerId               String?        @map("provider_id") @db.Uuid
  status                   OcrStatus      @default(PENDENTE)
  /// Texto cru devolvido pelo provedor. Imutável depois de PROCESSADO (bd/15 §6).
  extractedText            String?        @map("texto_extraido")
  /// Confiança de 0 a 100 — `Decimal`, como todo número que decide alguma coisa.
  confidence               Decimal?       @map("confianca_geral") @db.Decimal(5, 2)
  amount                   Decimal?       @map("valor_extraido") @db.Decimal(18, 2)
  issueDate                DateTime?      @map("data_extraida") @db.Date
  merchantName             String?        @map("estabelecimento_nome") @db.VarChar(255)
  /// Só dígitos: 11 (CPF) ou 14 (CNPJ) — é assim que casa com `parceiro`.
  merchantDocument         String?        @map("estabelecimento_documento") @db.VarChar(14)
  /// Chave de acesso da NF-e/NFC-e, 44 dígitos (RF-097).
  documentKey              String?        @map("chave_documento") @db.VarChar(44)
  documentNumber           String?        @map("numero_documento") @db.VarChar(30)
  suggestedCategoryId      String?        @map("categoria_sugerida_id") @db.Uuid
  suggestedCategory        Category?      @relation(fields: [suggestedCategoryId], references: [id])
  suggestedCostCenterId    String?        @map("centro_custo_sugerido_id") @db.Uuid
  suggestedCostCenter      CostCenter?    @relation(fields: [suggestedCostCenterId], references: [id])
  suggestedPartnerId       String?        @map("parceiro_sugerido_id") @db.Uuid
  suggestedPartner         Partner?       @relation(fields: [suggestedPartnerId], references: [id])
  /// Resposta crua do provedor, sem credencial. Imutável depois de PROCESSADO.
  rawPayload               Json?          @map("payload_bruto")
  validatedById            String?        @map("validado_por") @db.Uuid
  validatedAt              DateTime?      @map("validado_em") @db.Timestamptz(6)
  /// O que a pessoa corrigiu, ao lado do que a máquina leu — nunca por cima.
  corrections              Json?          @map("correcoes")
  error                    String?        @map("erro")
  attempts                 Int            @default(0) @map("tentativas") @db.SmallInt
  createdAt                DateTime       @default(now()) @map("criado_em") @db.Timestamptz(6)
  updatedAt                DateTime       @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  @@unique([companyId, documentId], map: "uq_ocr_documento")
  @@index([companyId, status], map: "ix_ocr_status")
  @@map("ocr_processamento")
}

// ---------------------------------------------------------------------------
// M17 — Notificações e Automação (RF-119 a RF-125) — Sprint 13
//
// Duas decisões estruturais governam este módulo:
//
//  1. **notificar não é agir**. Uma notificação registra que algo merece
//     atenção humana e para por aí — nenhum alerta prorroga parcela, cancela
//     ordem ou concilia movimento. A "automação" da RF-125 automatiza *o
//     aviso*, não a decisão: uma regra que pagasse sozinha transformaria um
//     erro de configuração em dinheiro saindo, sem ninguém no caminho.
//  2. **o aviso é idempotente**. `chave_dedupe` é o que impede a mesma parcela
//     vencendo de virar uma notificação por varredura — quinze avisos iguais
//     por dia treinam o destinatário a ignorar todos, inclusive o que importa.
// ---------------------------------------------------------------------------

/// Canal de entrega da notificação — `enum_canal_notificacao` (bd/01).
///
/// Só `INTERNO` e `EMAIL` têm adaptador nesta sprint (RF-119/RF-120); os demais
/// existem no tipo do banco e são recusados pela API até haver quem os entregue.
enum NotificationChannel {
  INTERNO
  EMAIL
  SMS
  PUSH
  WEBHOOK

  @@map("enum_canal_notificacao")
}

/// Situação da notificação — `enum_status_notificacao` (bd/01).
///
/// `PENDENTE` é o estado de quem ainda não foi entregue; `INTERNO` nasce
/// direto em `ENVIADA` porque a entrega é a própria gravação. A máquina de
/// estados é imposta pelo banco (bd/16 §4).
enum NotificationStatus {
  PENDENTE
  ENVIADA
  LIDA
  FALHA
  CANCELADA

  @@map("enum_status_notificacao")
}

/// gestao.notificacao — um aviso endereçado a alguém (RF-119 a RF-124).
///
/// `userId` nulo é aviso da empresa, visível a quem tem a permissão do assunto;
/// preenchido, é pessoal e só o destinatário lê. Sem relação com `User` de
/// propósito, como no restante do schema: ninguém navega a partir daqui.
model Notification {
  id             String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId      String              @map("empresa_id") @db.Uuid
  userId         String?             @map("usuario_id") @db.Uuid
  channel        NotificationChannel @default(INTERNO) @map("canal")
  /// VENCIMENTO | PAGAMENTO_PROCESSADO | PAGAMENTO_FALHOU | APROVACAO_PENDENTE | DIVERGENCIA.
  type           String              @map("tipo") @db.VarChar(60)
  title          String              @map("titulo") @db.VarChar(255)
  message        String              @map("mensagem")
  /// 1 (mais urgente) a 5. Ordena a caixa de entrada, não decide entrega.
  priority       Int                 @default(3) @map("prioridade") @db.SmallInt
  /// Tabela de `gestao` a que o aviso se refere, e o id dentro dela.
  entity         String?             @map("entidade") @db.VarChar(60)
  entityId       String?             @map("entidade_id") @db.Uuid
  link           String?             @map("link")
  status         NotificationStatus  @default(PENDENTE) @map("status")
  recipientEmail String?             @map("destinatario_email") @db.VarChar(255)
  /// Idempotência do aviso (bd/16 §3): o mesmo fato não notifica duas vezes.
  dedupeKey      String?             @map("chave_dedupe") @db.VarChar(200)
  sentAt         DateTime?           @map("enviada_em") @db.Timestamptz(6)
  readAt         DateTime?           @map("lida_em") @db.Timestamptz(6)
  error          String?             @map("erro")
  attempts       Int                 @default(0) @map("tentativas") @db.SmallInt
  createdAt      DateTime            @default(now()) @map("criado_em") @db.Timestamptz(6)

  @@index([userId, status, createdAt(sort: Desc)], map: "ix_notificacao_usuario")
  @@map("notificacao")
}

/// gestao.regra_automacao — quando avisar, quem avisar e por onde (RF-125).
///
/// `conditions` e `actions` são `jsonb` para o conjunto crescer sem migration,
/// mas a forma é fechada nos DTOs: uma condição que o motor não entende é uma
/// regra que avisa mais — ou menos — do que quem a escreveu autorizou.
model AutomationRule {
  id           String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId    String              @map("empresa_id") @db.Uuid
  name         String              @map("nome") @db.VarChar(120)
  description  String?             @map("descricao")
  /// TITULO_VENCENDO | PAGAMENTO_PROCESSADO | PAGAMENTO_FALHOU | APROVACAO_PENDENTE | DIVERGENCIA_CONCILIACAO.
  triggerEvent String              @map("evento_gatilho") @db.VarChar(80)
  conditions   Json                @default("{}") @map("condicoes")
  actions      Json                @map("acoes")
  /// Reservado para agendamento próprio (M18). A varredura desta sprint é
  /// periódica e única: uma expressão por regra multiplicaria as varreduras.
  cronSchedule String?             @map("agendamento_cron") @db.VarChar(60)
  isActive     Boolean             @default(true) @map("ativo")
  lastRunAt    DateTime?           @map("ultima_execucao_em") @db.Timestamptz(6)
  createdAt    DateTime            @default(now()) @map("criado_em") @db.Timestamptz(6)
  updatedAt    DateTime            @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  runs AutomationRuleRun[]

  @@unique([companyId, name], map: "uq_regra_automacao")
  @@index([companyId, triggerEvent], map: "ix_regra_automacao_evento")
  @@map("regra_automacao")
}

/// gestao.regra_automacao_execucao — o que cada rodada da regra produziu.
///
/// Append-only (bd/16 §7): é a resposta para "por que ninguém foi avisado?",
/// e uma execução que some leva a pergunta junto.
model AutomationRuleRun {
  id         String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId  String         @map("empresa_id") @db.Uuid
  ruleId     String         @map("regra_automacao_id") @db.Uuid
  rule       AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  status     JobStatus      @default(PENDENTE) @map("status")
  entityId   String?        @map("entidade_id") @db.Uuid
  result     Json?          @map("resultado")
  error      String?        @map("erro")
  executedAt DateTime       @default(now()) @map("executado_em") @db.Timestamptz(6)

  @@index([companyId, ruleId, executedAt(sort: Desc)], map: "ix_regra_automacao_execucao")
  @@map("regra_automacao_execucao")
}
